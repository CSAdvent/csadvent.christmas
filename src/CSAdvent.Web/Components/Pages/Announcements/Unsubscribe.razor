@page "/announcements/unsubscribe"
@using CSAdvent.Web.Announcements
@inject AnnouncementSubscriptions Subscriptions

<PageTitle>Unsubscribe · C# Advent</PageTitle>

<div class="max-w-2xl">
    @if (Done == true)
    {
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">You're off the list</h1>
        <p class="mt-4 text-slate-700">We've deleted your address, so you won't get C# Advent's announcements anymore.</p>
        <p class="mt-6"><a href="" class="font-medium text-advent-700 underline">Back to C# Advent</a></p>
    }
    else if (_valid)
    {
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">Unsubscribe from announcements?</h1>
        <p class="mt-4 text-slate-700">
            You'll stop getting C# Advent's announcements, and we'll delete your address. Emails about a spot you have aren't
            affected.
        </p>
        @* A plain form (not an EditForm): it posts to the same endpoint mail providers use for one-click unsubscribe. *@
        <form method="post" action="@($"{AnnouncementSubscriptions.StopPath.TrimStart('/')}?token={Uri.EscapeDataString(Token!)}")" class="mt-6">
            <button type="submit" class="rounded-lg bg-advent-600 px-5 py-2.5 font-semibold text-white hover:bg-advent-700">Unsubscribe</button>
        </form>
    }
    else
    {
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">This link doesn't work anymore</h1>
        <p class="mt-4 text-slate-700">
            You may have unsubscribed already. If you're still getting announcements you don't want, reply to one of them and
            we'll sort it out.
        </p>
    }
</div>

@code {
    private bool _valid;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery]
    public bool? Done { get; set; }

    protected override async Task OnInitializedAsync() =>
        _valid = Subscriptions.TryReadStopToken(Token, out var subscriberId) && await Subscriptions.ExistsAsync(subscriberId);
}
