@page "/about"
@using Microsoft.Extensions.Options
@inject ContentService Content
@inject IOptions<SiteOptions> Site

<PageTitle>About · C# Advent</PageTitle>
<SocialMeta Title="About C# Advent" Description="How C# Advent works, where it came from, and who runs it." />

<article class="max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">About C# Advent</h1>

    @if (_about is { } about)
    {
        <div class="mt-6 text-lg"><MarkdownBlock Text="@about" /></div>
    }

    @if (Site.Value.Organizers.Count > 0)
    {
        <h2 class="mt-12 text-xl font-semibold text-slate-900">Who runs it</h2>
        <ul class="mt-4 flex flex-wrap gap-6">
            @foreach (var organizer in Site.Value.Organizers)
            {
                <li class="flex items-center gap-3">
                    <img src="@($"https://github.com/{organizer.GitHub}.png?size=128")" alt="" width="64" height="64" class="size-16 rounded-full ring-1 ring-slate-200" loading="lazy" />
                    <span>
                        <span class="block font-semibold text-slate-900">@organizer.Name</span>
                        <a href="@($"https://github.com/{organizer.GitHub}")" class="text-sm text-advent-700 underline">@@@organizer.GitHub</a>
                    </span>
                </li>
            }
        </ul>
    }

    <h2 class="mt-12 text-xl font-semibold text-slate-900">Built with</h2>
    <p class="mt-3 text-slate-700">
        C# of course: .NET 11 and Blazor, orchestrated by Aspire, with PostgreSQL, running on Azure Container Apps. Styled with
        Tailwind CSS, emails sent with Azure Communication Services, and share cards drawn with SkiaSharp.
    </p>

    <p class="mt-12 text-slate-700">
        Looking for more? Here are <a href="others" class="text-advent-700 underline">other developer advent calendars</a>.
    </p>
</article>

@code {
    private string? _about;

    protected override async Task OnInitializedAsync() => _about = await Content.GetAsync(ContentCatalog.About);
}
