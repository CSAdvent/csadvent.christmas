@page "/archive"
@inject ArchiveService Archive

<PageTitle>Archive · C# Advent</PageTitle>

<h1 class="text-3xl font-bold tracking-tight text-slate-900">The C# Advent archive</h1>
<p class="mt-2 text-slate-600">Every season since the first one in 2017: @_seasons.Sum(s => s.Posts) posts from the C# community.</p>

<ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var season in _seasons)
    {
        <li>
            <a href="archive/@season.Year" class="group flex items-baseline justify-between gap-4 rounded-xl bg-white p-4 shadow-sm ring-1 ring-slate-200 hover:ring-advent-400">
                <span class="text-2xl font-bold tabular-nums text-slate-900 group-hover:text-advent-700">@season.Year</span>
                <span class="text-sm text-slate-500">@season.Posts posts</span>
            </a>
        </li>
    }
</ul>

@code {
    private IReadOnlyList<ArchivedSeasonSummary> _seasons = [];

    protected override async Task OnInitializedAsync() => _seasons = await Archive.GetSeasonsAsync();
}
