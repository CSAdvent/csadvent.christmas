@page "/archive/{Year:int}"
@using Microsoft.Extensions.Options
@inject ArchiveService Archive
@inject AdventSchedule Schedule
@inject IOptions<SiteOptions> Site
@inject CSAdvent.Web.Retrospectives.RetrospectiveService Retrospectives
@inject NavigationManager Navigation

@if (_calendar is not null)
{
    <PageTitle>C# Advent @_calendar.Year · Archive</PageTitle>
    <SocialMeta Title="@($"C# Advent {_calendar.Year}")"
                Description="@($"{_calendar.PostCount} C# posts from December 1 to 25, {_calendar.Year}, written by the community.")"
                Image="@CSAdvent.Web.Cards.CardLinks.Season(_calendar.Year, _calendar.PostCount)"
                ImageAlt="@($"C# Advent {_calendar.Year}: {_calendar.PostCount} C# posts")">
        <link rel="alternate" type="application/rss+xml" title="@($"C# Advent {_calendar.Year}")" href="@($"archive/{_calendar.Year}/rss")" />
        @if (_calendar.Year != CSAdvent.Web.Data.Season.TestYear)
        {
            <JsonLd Data="@(StructuredData.SeasonEvent(_calendar.Year, Schedule, Site.Value.BaseUrl, $"archive/{_calendar.Year}", CSAdvent.Web.Cards.CardLinks.Season(_calendar.Year, _calendar.PostCount)))" />
        }
    </SocialMeta>

    <nav aria-label="Seasons" class="mb-6 flex flex-wrap items-center justify-between gap-3 text-sm font-medium">
        <a href="archive" class="text-advent-700 hover:underline">All seasons</a>
        <span class="flex gap-4">
            @if (_previousYear is { } previous)
            {
                <a href="archive/@previous" class="text-advent-700 hover:underline">← @previous</a>
            }
            @if (_nextYear is { } next)
            {
                <a href="archive/@next" class="text-advent-700 hover:underline">@next →</a>
            }
        </span>
    </nav>

    <header class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">C# Advent @_calendar.Year</h1>
        <p class="mt-2 text-slate-600">@_calendar.PostCount posts from December 1 to December 25, @_calendar.Year.</p>
        @if (_calendar.Notes is not null)
        {
            <div class="mt-2 text-slate-600 [&_a]:text-advent-700 [&_a]:underline">@Markdown.ToHtml(_calendar.Notes)</div>
        }
        @if (_hasRetrospective)
        {
            <a href="@CSAdvent.Web.Retrospectives.RetrospectiveLinks.Page(_calendar.Year)" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-advent-50 px-4 py-2 font-semibold text-advent-800 ring-1 ring-advent-200 hover:bg-advent-100">
                Read the look back at @_calendar.Year <span aria-hidden="true">→</span>
            </a>
        }
    </header>

    <CalendarGrid Calendar="_calendar" />
}

@code {
    private SeasonCalendar? _calendar;
    private int? _previousYear;
    private int? _nextYear;
    private bool _hasRetrospective;

    [Parameter]
    public int Year { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _calendar = await Archive.GetSeasonAsync(Year);

        if (_calendar is null)
        {
            Navigation.NotFound();
            return;
        }

        var years = (await Archive.GetSeasonsAsync()).Select(s => (int?)s.Year).ToList();
        _previousYear = years.Where(y => y < Year).Max();
        _nextYear = years.Where(y => y > Year).Min();
        _hasRetrospective = await Retrospectives.IsPublishedAsync(Year);
    }
}
