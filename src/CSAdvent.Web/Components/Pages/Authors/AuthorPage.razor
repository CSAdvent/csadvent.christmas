@page "/authors/{Login}"
@page "/authors/name/{NameKey}"
@using CSAdvent.Web.Authors
@inject AuthorPageService Authors
@inject NavigationManager Navigation

@if (_author is { } author)
{
    <PageTitle>@author.Name · C# Advent authors</PageTitle>
    <SocialMeta Title="@($"{author.Name} on C# Advent")" Description="@author.Description" />

    <nav class="mb-6 text-sm font-medium">
        <a href="authors" class="text-advent-700 hover:underline">← Every author</a>
    </nav>

    <header class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-advent-700">C# Advent author</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">@author.Name</h1>
        <p class="mt-2 text-lg text-slate-600">@author.Summary</p>
        @if (author.Links.Count > 0)
        {
            <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="@($"{author.Name} on the web")">
                @foreach (var link in author.Links)
                {
                    <li><a href="@link.Url" class="text-advent-700 underline">@link.Label</a></li>
                }
            </ul>
        }
    </header>

    @foreach (var season in author.Seasons)
    {
        <section class="mt-10 max-w-3xl">
            <h2 class="text-xl font-semibold text-slate-900">C# Advent @season.Key</h2>
            <ul class="mt-3 flex flex-col gap-3">
                @foreach (var post in season)
                {
                    <li class="rounded-xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">@post.Spot</p>
                        <a href="@post.Page" class="mt-1 inline-block font-semibold text-advent-700 underline decoration-advent-200 underline-offset-2 hover:decoration-advent-700">@post.Title</a>
                        @if (post.Summary is { } summary)
                        {
                            <p class="mt-1 text-slate-600">@summary</p>
                        }
                        @if (!string.Equals(post.AuthorName, author.Name, StringComparison.Ordinal))
                        {
                            <p class="mt-1 text-sm text-slate-500">as @post.AuthorName</p>
                        }
                    </li>
                }
            </ul>
        </section>
    }
}

@code {
    private AuthorPageView? _author;

    /// <summary>A linked author's GitHub login, in any case.</summary>
    [Parameter]
    public string? Login { get; set; }

    /// <summary>An unlinked archive author's name key (<see cref="CSAdvent.Web.Manage.AuthorService.Key"/>).</summary>
    [Parameter]
    public string? NameKey { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Login is not null)
        {
            _author = await Authors.GetByLoginAsync(Login);
        }
        else if (NameKey is not null)
        {
            // The server leaves an escaped slash escaped in the path, though no name has one yet.
            var key = NameKey.Replace("%2F", "/", StringComparison.OrdinalIgnoreCase);
            _author = await Authors.GetByNameAsync(key);
            if (_author is null && await Authors.FindLinkedPageAsync(key) is { } linkedPage)
            {
                // Linked to a GitHub account since: their page is the account's now.
                Navigation.NavigateTo(linkedPage);
                return;
            }
        }

        if (_author is null)
        {
            Navigation.NotFound();
        }
    }
}
