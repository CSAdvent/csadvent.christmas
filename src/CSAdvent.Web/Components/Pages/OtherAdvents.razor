@page "/others"
@using CSAdvent.Web.Manage
@inject ContentService Content
@inject OtherAdventsService Others
@inject SeasonAdminService Seasons

<PageTitle>Other Advents · C# Advent</PageTitle>
<SocialMeta Title="Other developer advent calendars" Description="More developer advent calendars to enjoy this December, from F# to Advent of Code." />

<article>
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Other Advent calendars</h1>

    @if (_intro is { } intro)
    {
        <div class="mt-6 max-w-3xl text-lg"><MarkdownBlock Text="@intro" /></div>
    }

    @if (_list is { } list)
    {
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
            @foreach (var advent in list.Items)
            {
                <li>
                    <a href="@advent.Url" class="group flex h-full items-start gap-5 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 transition hover:shadow-md hover:ring-advent-400">
                        <AdventLogo Item="advent" />
                        <span class="min-w-0">
                            <span class="block text-xl font-semibold text-slate-900 group-hover:text-advent-700">@advent.Name</span>
                            <span class="block truncate text-sm text-slate-500">@advent.Host</span>
                            @if (advent.Description is { } description)
                            {
                                <span class="mt-2 block text-slate-600">@description</span>
                            }
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
</article>

@code {
    private string? _intro;
    private OtherAdventsList? _list;

    protected override async Task OnInitializedAsync()
    {
        _intro = await Content.GetAsync(ContentCatalog.OtherAdvents);
        _list = await Others.GetForPageAsync(await Seasons.GetCurrentYearAsync());
    }
}
