@page "/dev/signin-options"
@using CSAdvent.Web.Auth
@using Microsoft.Extensions.Options
@inject IHostEnvironment Environment
@inject IOptions<AccountOptions> Accounts
@inject NavigationManager Navigation

@if (_enabled)
{
    <PageTitle>Dev sign-in · C# Advent</PageTitle>

    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Dev sign-in</h1>
    <p class="mt-2 text-slate-600">Sign in as anyone, without GitHub. This page only exists in development.</p>

    <ul class="mt-6 flex flex-col gap-3 sm:flex-row">
        @if (_organizerId is { } organizerId)
        {
            <li><a href="@SignInLink("organizer", organizerId)" class="inline-block rounded-lg bg-advent-600 px-4 py-2 font-semibold text-white hover:bg-advent-700">Sign in as an organizer</a></li>
        }
        <li><a href="@SignInLink("contributor", 1001)" class="inline-block rounded-lg bg-advent-600 px-4 py-2 font-semibold text-white hover:bg-advent-700">Sign in as a contributor</a></li>
    </ul>

    <form method="get" action="dev/signin" class="mt-8 flex flex-wrap items-end gap-3">
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <label class="flex flex-col text-sm font-medium text-slate-700">
            GitHub login
            <input name="login" required maxlength="39" class="mt-1 rounded-lg border border-slate-300 px-3 py-2" />
        </label>
        <label class="flex flex-col text-sm font-medium text-slate-700">
            GitHub user ID
            <input name="id" type="number" min="1" required class="mt-1 rounded-lg border border-slate-300 px-3 py-2" />
        </label>
        <button type="submit" class="rounded-lg bg-slate-700 px-4 py-2 font-semibold text-white hover:bg-slate-800">Sign in</button>
    </form>
}

@code {
    private bool _enabled;
    private long? _organizerId;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        _enabled = AccountEndpoints.IsDevSignInEnabled(Environment, Accounts.Value);

        if (!_enabled)
        {
            Navigation.NotFound();
            return;
        }

        _organizerId = Accounts.Value.Admins.Length > 0 ? Accounts.Value.Admins[0] : null;
    }

    private string SignInLink(string login, long id) =>
        $"dev/signin?login={login}&id={id}&returnUrl={Uri.EscapeDataString(Auth.ReturnUrl.Sanitize(ReturnUrl))}";
}
