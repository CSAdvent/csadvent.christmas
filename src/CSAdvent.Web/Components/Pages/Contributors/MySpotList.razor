@page "/my-spots"
@attribute [Authorize]
@using CSAdvent.Web.Auth
@using CSAdvent.Web.Blurbs
@using CSAdvent.Web.Components.Manage
@using CSAdvent.Web.Contributors
@using CSAdvent.Web.Manage
@inject MySpotsService MySpots
@inject PostClaimService PostClaims
@inject PostLinkService PostLinks
@inject BlurbQueries Blurbs
@inject Microsoft.Extensions.Options.IOptions<SiteOptions> Site

<PageTitle>My spots · C# Advent</PageTitle>

<h1 class="text-3xl font-bold tracking-tight text-slate-900">My spots</h1>
<p class="mt-2 max-w-2xl text-slate-600">
    Add your post's title and URL here; that's how it gets onto the calendar. You can add them before the post is public, as long
    as you don't publish it until your day. The name, link and social accounts we fill in for you are on
    <a href="profile" class="text-advent-700 underline">your profile</a>.
</p>

@if (Done is "withdrawn" or "not-withdrawn")
{
    <p class="mt-6 max-w-2xl rounded-xl p-4 font-medium ring-1 @(Done == "withdrawn" ? "bg-green-50 text-green-800 ring-green-200" : "bg-amber-50 text-amber-900 ring-amber-200")" role="status">
        @(Done == "withdrawn" ? "You've withdrawn your request." : "That request isn't waiting any more: the organizers have just decided it, so check your email.")
    </p>
}

@if (_overview is { } overview)
{
    @if (overview.Spots.Count == 0)
    {
        <div class="mt-8 max-w-2xl rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
            <p class="font-medium text-slate-900">You don't have a spot yet.</p>
            <p class="mt-2 text-slate-600">
                @(overview.PendingRequests.Count > 0
                    ? "Your request is waiting for the organizers. We'll email you once they've decided."
                    : "Pick an open day on the calendar to request one. If an organizer added you by hand, make sure the verified email on your GitHub account is the one you gave them.")
            </p>
        </div>
    }
    else
    {
        @foreach (var season in overview.Spots.Where(s => BlurbRules.AppliesTo(s.Year)).GroupBy(s => s.Year))
        {
            var blurb = SuggestedBlurb.For(season.Key, season.First().SlotsPerDay);
            <section class="mt-8 max-w-3xl rounded-xl bg-advent-50 p-5 ring-1 ring-advent-100">
                <h2 class="font-semibold text-slate-900">Open your post with the C# Advent blurb</h2>
                <p class="mt-1 text-sm text-slate-700">
                    Start your post by saying it's part of the @season.Key C# Advent calendar, with a link to csadvent.christmas. Any
                    wording is fine, as long as it says that and links back. We check every post from the day before it's revealed,
                    and a post without it by the time it's announced goes to a backup poster. Here's one ready to paste:
                </p>
                <dl class="mt-4 flex flex-col gap-3 text-sm">
                    @foreach (var (format, text) in new[] { ("Text", blurb.Text), ("Markdown", blurb.Markdown), ("HTML", blurb.Html) })
                    {
                        var id = $"blurb-{season.Key}-{format.ToLowerInvariant()}";
                        <div>
                            <dt class="flex items-center justify-between gap-2 font-medium text-slate-700">
                                @format
                                <button type="button" data-copy="@id" class="rounded-md bg-white px-2 py-1 text-xs font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50">Copy</button>
                            </dt>
                            <dd><pre id="@id" class="mt-1 whitespace-pre-wrap break-words rounded-lg bg-white p-3 font-mono text-xs text-slate-800 ring-1 ring-slate-200">@text</pre></dd>
                        </div>
                    }
                </dl>
            </section>
        }

        <ul class="mt-8 flex max-w-3xl flex-col gap-4">
            @foreach (var spot in overview.Spots)
            {
                <li class="flex flex-wrap items-center justify-between gap-4 rounded-xl p-5 ring-1 ring-slate-200">
                    <div>
                        <p class="font-semibold text-slate-900">@spot.Spot</p>
                        <p class="mt-1 text-sm text-slate-600">
                            @if (spot.Status is EntryStatus.Ready)
                            {
                                <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-800">Ready</span>
                                <a href="@spot.PostUrl" class="ml-2 text-advent-700 underline">@spot.PostTitle</a>
                            }
                            else
                            {
                                <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">Needs your post's title and URL</span>
                            }
                        </p>
                        @if (spot.Status is EntryStatus.Ready && BlurbRules.AppliesTo(spot.Year) && Blurbs.IsEnabled && !spot.IsDayOver)
                        {
                            <p class="mt-1 text-sm text-slate-600">@BlurbNote(_blurbs.GetValueOrDefault(spot.SlotId))</p>
                        }
                        @if (spot.IsRevealed && spot.Status is EntryStatus.Ready)
                        {
                            <p class="mt-1 text-sm text-slate-500">@(spot.Traffic.Any ? Traffic(spot.Traffic) : "No visits or clicks counted yet.")</p>
                        }
                    </div>
                    @if (!spot.IsDayOver || spot.Status is EntryStatus.Ready)
                    {
                        <a href="my-spots/@spot.SlotId" class="rounded-lg bg-advent-600 px-4 py-2 font-semibold text-white hover:bg-advent-700">
                            @(spot.Status is EntryStatus.Ready ? "Edit" : "Add your post")
                        </a>
                    }
                </li>
            }
        </ul>
    }

    @if (overview.PendingRequests.Count > 0)
    {
        <h2 class="mt-12 text-xl font-semibold text-slate-900">Waiting for approval</h2>
        <ul class="mt-4 flex max-w-3xl flex-col gap-3 text-slate-700">
            @foreach (var request in overview.PendingRequests)
            {
                <li class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p>@request.Spot <span class="text-sm text-slate-500">(requested <LocalTime Value="request.SubmittedAt" />)</span></p>
                        @if (request.SpotTaken)
                        {
                            <p class="mt-1 text-sm text-amber-800">
                                This spot has gone to someone else. We'll email you when the organizers get to your request, or withdraw it
                                and request another day.
                            </p>
                        }
                    </div>
                    @* A plain form to a minimal API, because there's one per request. *@
                    <form method="post" action="my-spots/requests/withdraw">
                        <AntiforgeryToken />
                        <input type="hidden" name="RequestId" value="@request.Id" />
                        <button type="submit" class="rounded-lg bg-white px-3 py-1.5 text-sm font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50">Withdraw</button>
                    </form>
                </li>
            }
        </ul>
    }

    @if (_history.Count > 0)
    {
        <section class="mt-12 max-w-3xl">
            <h2 class="text-xl font-semibold text-slate-900">Your C# Advent history</h2>
            <p class="mt-1 text-slate-600">@HistorySummary</p>
            <ul class="mt-4 flex flex-col gap-4">
                @foreach (var season in _history.GroupBy(p => p.Year))
                {
                    <li>
                        <a href="@($"archive/{season.Key}")" class="font-semibold text-slate-900 hover:text-advent-700">C# Advent @season.Key</a>
                        <ul class="mt-1 flex flex-col gap-1">
                            @foreach (var post in season)
                            {
                                <li class="text-slate-700">
                                    <span class="text-sm text-slate-500">@post.Spot:</span>
                                    <a href="@post.EntryPage" class="text-advent-700 underline">@post.Title</a>
                                    @if (post.Traffic.Any)
                                    {
                                        <span class="text-sm text-slate-500">· @Traffic(post.Traffic)</span>
                                    }
                                </li>
                            }
                        </ul>
                    </li>
                }
            </ul>
            <p class="mt-4 text-sm text-slate-600">
                @if (_pendingLinks is { } pending)
                {
                    <text>You've asked for new links to @(pending.Changes.Count == 1 ? "1 post" : $"{pending.Changes.Count} posts"), and an organizer will check them.</text>
                    <a href="@PostLinkLinks.Request" class="font-medium text-advent-700 underline">See your request</a>
                }
                else
                {
                    <text>Moved your blog, or one of these posts?</text>
                    <a href="@PostLinkLinks.Request" class="font-medium text-advent-700 underline">Change their links</a>
                }
            </p>
        </section>
    }

    @if (overview.Spots.Any(s => s.IsRevealed && s.Status is EntryStatus.Ready) || _history.Any(p => p.Traffic.Any))
    {
        <p class="mt-10 max-w-3xl text-sm text-slate-500">
            Visits are people opening your post's page on our site, and clicks are readers following a link through to your post,
            from the calendar or that page. They're counted from 2026 on, without search engines, link previews or other bots, and
            nothing about the readers is recorded. Only you see these for your posts; the season's retrospective shows its totals
            and its ten most-read posts.
        </p>
    }

    <section id="older-posts" class="mt-12 max-w-3xl">
        <h2 class="text-xl font-semibold text-slate-900">Wrote for C# Advent before?</h2>
        <p class="mt-1 text-slate-600">
            Find your posts from earlier seasons and ask for them to be added to your account. An organizer checks each one.
        </p>

        @if (_pendingPosts.Count > 0)
        {
            <h3 class="mt-6 font-semibold text-slate-900">Waiting for an organizer</h3>
            <ul class="mt-2 flex flex-col gap-1">
                @foreach (var post in _pendingPosts)
                {
                    <li class="text-slate-700"><span class="text-sm text-slate-500">@post.Spot:</span> <a href="@post.EntryPage" class="text-advent-700 underline">@post.Title</a></li>
                }
            </ul>
        }

        <form method="get" action="my-spots#older-posts" class="mt-6 flex flex-wrap items-end gap-3">
            <label class="flex min-w-0 flex-1 flex-col text-sm font-medium text-slate-700">
                The name you wrote under
                <input type="search" name="find" value="@(Find ?? _suggestedName)" minlength="2" maxlength="100" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
            </label>
            <button type="submit" class="rounded-lg bg-white px-4 py-2 font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50">Find my posts</button>
        </form>

        @if (Find is not null)
        {
            @if (_found.Count == 0)
            {
                <p class="mt-4 text-slate-600">No posts that aren't on someone's account match "@Find". Try part of your name, or the name you used then.</p>
            }
            else
            {
                <ul class="mt-4 flex flex-col gap-2">
                    @foreach (var post in _found)
                    {
                        <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg p-3 ring-1 ring-slate-200">
                            <div>
                                <p class="text-sm text-slate-500">C# Advent · @post.Spot</p>
                                <p><a href="@post.EntryPage" class="font-medium text-advent-700 underline">@post.Title</a> <span class="text-slate-600">by @post.Author</span></p>
                            </div>
                            @if (post.Requested)
                            {
                                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">Requested</span>
                            }
                            else
                            {
                                <a href="@post.ClaimPage" class="rounded-lg px-3 py-1.5 text-sm font-semibold text-advent-700 ring-1 ring-advent-300 hover:bg-advent-50">This is mine</a>
                            }
                        </li>
                    }
                </ul>
            }
        }

        <p class="mt-6 text-sm text-slate-500">
            Is one of your posts already on someone else's account, by mistake or because someone pretended to be you? Email
            <a href="mailto:@Site.Value.ContactEmail" class="text-advent-700 underline">@Site.Value.ContactEmail</a> and we'll sort it out.
        </p>
    </section>
}

@code {
    private MySpotsOverview? _overview;
    private Dictionary<int, BlurbState> _blurbs = [];
    private IReadOnlyList<PastPost> _history = [];
    private IReadOnlyList<ClaimablePost> _pendingPosts = [];
    private IReadOnlyList<ClaimablePost> _found = [];
    private PostLinkReview? _pendingLinks;
    private string? _suggestedName;

    /// <summary>A search for older posts by author name.</summary>
    [SupplyParameterFromQuery]
    public string? Find { get; set; }

    [SupplyParameterFromQuery]
    public string? Done { get; set; }

    private string HistorySummary
    {
        get
        {
            var seasons = _history.Select(p => p.Year).Distinct().Count();
            var posts = _history.Count;
            return $"Welcome back! You've written {posts} {(posts == 1 ? "post" : "posts")} across {seasons} {(seasons == 1 ? "season" : "seasons")}. Thank you.";
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    /// <summary>Where their post stands on the blurb, in their words.</summary>
    private static string BlurbNote(BlurbState? blurb) => blurb?.Status switch
    {
        CSAdvent.Web.Data.BlurbStatus.Passed => "C# Advent blurb: found. Thank you!",
        CSAdvent.Web.Data.BlurbStatus.Waived => "C# Advent blurb: an organizer has OK'd your post.",
        CSAdvent.Web.Data.BlurbStatus.Missing => $"C# Advent blurb: missing. {blurb.Detail} Add it at the top of your post; we check again every few minutes.",
        CSAdvent.Web.Data.BlurbStatus.NeedsDecision or CSAdvent.Web.Data.BlurbStatus.CouldNotCheck => "C# Advent blurb: an organizer is taking a look.",
        _ => "C# Advent blurb: we check for it from the day before your post is revealed.",
    };

    private static string Traffic(PostTraffic traffic) => string.Create(
        System.Globalization.CultureInfo.InvariantCulture,
        $"{traffic.Views:N0} {(traffic.Views == 1 ? "visit" : "visits")}, {traffic.Clicks:N0} {(traffic.Clicks == 1 ? "click" : "clicks")} through to your post");

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        _overview = await MySpots.GetOverviewAsync(user.GetContributorId() ?? 0);
        _blurbs = await Blurbs.GetSlotsAsync([.. _overview.Spots.Select(s => s.SlotId)]);
        _history = await MySpots.GetHistoryAsync(user.GetContributorId() ?? 0);
        _pendingPosts = await PostClaims.GetPendingAsync(user.GetContributorId() ?? 0);
        _found = await PostClaims.SearchAsync(user.GetContributorId() ?? 0, Find);
        _pendingLinks = await PostLinks.GetPendingAsync(user.GetContributorId() ?? 0);

        // Their name is the likeliest search, until they've searched for something else.
        _suggestedName = user.GetDisplayName();
    }
}
