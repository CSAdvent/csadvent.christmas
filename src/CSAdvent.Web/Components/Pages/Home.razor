@page "/"

<PageTitle>C# Advent</PageTitle>

<div class="flex flex-col items-center gap-6 py-6 text-center sm:py-10">
    <img src="@Assets["images/csadvent-logo.png"]" alt="C# Advent logo" width="160" height="160" class="size-32 rounded-2xl shadow-lg sm:size-40" />
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-advent-800 sm:text-4xl">C# Advent</h1>
        <p class="mt-3 max-w-xl text-lg text-slate-600">Two new C# posts every day from December 1st to December 25th, written by the C# community.</p>
    </div>
    <a href="archive" class="rounded-lg bg-advent-600 px-5 py-3 font-semibold text-white shadow hover:bg-advent-700">Browse every season since 2017</a>
</div>
