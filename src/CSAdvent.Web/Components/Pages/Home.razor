@page "/"
@inject HomeService HomeService

<PageTitle>C# Advent</PageTitle>

@if (_home?.Calendar is { } calendar)
{
    @if (_home.IsOffSeason)
    {
        <OffSeason Calendar="calendar" />
    }
    else
    {
        <CurrentSeason Calendar="calendar" />
    }
}
else if (_home is not null)
{
    <h1 class="text-3xl font-bold tracking-tight text-advent-800">C# Advent</h1>
    <p class="mt-2 text-slate-600">Two new C# posts every day from December 1st to December 25th. Check back soon!</p>
}

@code {
    private HomePage? _home;

    protected override async Task OnInitializedAsync() => _home = await HomeService.GetAsync();
}
