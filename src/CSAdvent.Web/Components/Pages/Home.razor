@page "/"
@inject HomeService HomeService
@inject ContentService Content

<PageTitle>C# Advent</PageTitle>
<SocialMeta Title="C# Advent"
            Description="Two new C# posts every day from December 1st to December 25th, written by the C# community."
            Image="@CardImage()" />

@if (_home is { Calendar: { } calendar })
{
    <CurrentSeason Calendar="calendar" />
}
else if (_home is not null)
{
    <OffSeason LastSeason="_home.LastSeason" NextSeason="_home.NextSeason" Message="@_message" />
}

@code {
    private HomePage? _home;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _home = await HomeService.GetAsync();
        if (_home.IsBetweenSeasons)
        {
            _message = await Content.GetAsync(ContentCatalog.BetweenSeasons);
        }
    }

    private string CardImage() => _home switch
    {
        { Calendar: { } calendar } => CSAdvent.Web.Cards.CardLinks.Season(calendar.Year, postCount: null),
        { LastSeason: { } last } => CSAdvent.Web.Cards.CardLinks.Season(last.Year, last.PostCount),
        _ => "images/social-card.jpg",
    };
}
