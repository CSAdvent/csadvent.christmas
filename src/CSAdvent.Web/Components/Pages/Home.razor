@page "/"
@using CSAdvent.Web.Auth
@using Microsoft.Extensions.Options
@inject HomeService HomeService
@inject ContentService Content
@inject AdventSchedule Schedule
@inject IOptions<SiteOptions> Site
@inject IOptions<CSAdvent.Web.Social.SocialAccountsOptions> Accounts
@inject CSAdvent.Web.Contributors.MySpotsService MySpots

<PageTitle>@Title</PageTitle>
<SocialMeta Title="@Title"
            Description="Two new C# posts every day from December 1st to December 25th, written by the C# community."
            Image="@Image">
    <JsonLd Data="StructuredData.WebSite(Site.Value.BaseUrl, Accounts.Value)" />
    @if (EventYear is { } year)
    {
        <JsonLd Data="@(StructuredData.SeasonEvent(year, Schedule, Site.Value.BaseUrl, page: "", Image))" />
    }
</SocialMeta>

@if (_home is { Calendar: { } calendar })
{
    <CurrentSeason Calendar="calendar" />
}
else if (_home is not null)
{
    <OffSeason LastSeason="_home.LastSeason" NextSeason="_home.NextSeason" Message="@_message" IsSignedIn="_signedIn">
        <Subscribe>
            <CSAdvent.Web.Components.Announcements.SubscribeBox Heading="Get an email when sign-ups open" ReturnTo="home" Done="@Done" Error="@Error" />
        </Subscribe>
    </OffSeason>
}

@code {
    private const string Title = "C# Advent: two C# posts a day, December 1–25";

    private HomePage? _home;
    private string? _message;
    private bool _signedIn;

    private string Image => _home is null ? CSAdvent.Web.Cards.CardLinks.General : CSAdvent.Web.Cards.CardLinks.Home(_home);

    /// <summary>The season the page is about, as an event (#195): the one on the calendar, or between seasons the next one.</summary>
    private int? EventYear => (_home?.Calendar?.Year ?? _home?.NextSeason?.Year) is { } year && year != CSAdvent.Web.Data.Season.TestYear ? year : null;

    [SupplyParameterFromQuery]
    public string? Done { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _home = await HomeService.GetAsync();
        if (_home.IsBetweenSeasons)
        {
            _message = await Content.GetAsync(ContentCatalog.BetweenSeasons);

            // Past authors are invited to sign in and see their history (#200), or sent straight to it once they have.
            _signedIn = (await AuthenticationState).User.Identity?.IsAuthenticated == true;
        }
        else if ((await AuthenticationState).User.GetContributorId() is { } contributorId)
        {
            // A signed-in contributor sees their own spots and requests marked (#175). Everyone else gets the same page.
            _home = _home with { Calendar = _home.Calendar! with { Marks = await MySpots.GetCalendarMarksAsync(contributorId, _home.Calendar.Year) } };
        }
    }
}
