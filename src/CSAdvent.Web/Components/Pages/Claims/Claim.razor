@page "/claim/{Year:int}/{Day:int}/{Part:int}"
@attribute [Authorize]
@using CSAdvent.Web.Auth
@using CSAdvent.Web.Blurbs
@using CSAdvent.Web.Claims
@inject ClaimService Claims
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<SiteOptions> Site

@if (_slot is not null)
{
    <PageTitle>Request December @Day · C# Advent</PageTitle>

    <nav class="mb-6 text-sm font-medium"><a href="" class="text-advent-700 hover:underline">← Back to the calendar</a></nav>

    @if (_slot.Availability is not ClaimAvailability.Open)
    {
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">December @Day, @Year isn't available</h1>
        <p class="mt-2 text-slate-600">
            @(_slot.Availability switch
            {
                ClaimAvailability.ClaimsNotOpen => "Sign-ups aren't open for this season.",
                ClaimAvailability.AlreadyClaimed => "This spot has already been claimed. Pick another open spot on the calendar.",
                _ => "This day has already been revealed, so it can't be claimed any more.",
            })
        </p>
    }
    else if (_email is null)
    {
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">We need a verified email</h1>
        <p class="mt-2 max-w-2xl text-slate-600">
            We contact contributors at the primary email address on their GitHub account, once GitHub has verified it, and yours
            isn't verified yet. Verify it, or make a verified address your primary one, in your
            <a href="https://github.com/settings/emails" class="text-advent-700 underline">GitHub email settings</a>, then sign out
            and sign in again.
        </p>
    }
    else if (_pending >= Claims.MaxPendingPerSeason)
    {
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">You have @_pending @(_pending == 1 ? "request" : "requests") waiting</h1>
        <p class="mt-2 max-w-2xl text-slate-600">
            That's as many as anyone can have waiting at once. Once the organizers have answered one, or you've withdrawn one on
            <a href="my-spots" class="text-advent-700 underline">My spots</a>, you can ask for another.
        </p>
    }
    else
    {
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">Request December @Day, @Year</h1>
        <p class="mt-2 max-w-2xl text-slate-600">
            You're asking for @(_slot.SlotsPerDay > 1 ? $"post {Part} of {_slot.SlotsPerDay}" : "the post") on December @Day.
            You don't need a topic or a post yet; you can add those later. The organizers review requests in the order they arrive,
            and you can have up to @Claims.MaxPendingPerSeason waiting at once.
        </p>

        @if (_error is not null)
        {
            <p class="mt-6 rounded-xl bg-red-50 p-4 font-medium text-red-800 ring-1 ring-red-200" role="alert">@_error</p>
        }
    }

    @* Also rendered (hidden) when it was just posted, so a post that arrives after the spot was taken or revealed reaches its
       handler and gets the message above, instead of an error page. *@
    @if (CanRequest || _posted)
    {
        <EditForm Model="Form" FormName="claim" OnValidSubmit="SubmitAsync" hidden="@(!CanRequest)" class="mt-8 flex max-w-2xl flex-col gap-6">
            <DataAnnotationsValidator />
            <ValidationSummary class="rounded-xl bg-red-50 p-4 text-sm ring-1 ring-red-200" />

            <div>
                <label for="display-name" class="block font-medium text-slate-800">Name</label>
                <InputText id="display-name" @bind-Value="Form!.DisplayName" maxlength="50" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
                <p class="mt-1 text-sm text-slate-500">Shown publicly on the calendar.</p>
            </div>

            <div>
                <span class="block font-medium text-slate-800">Email</span>
                <p class="mt-1 text-slate-700">@_email</p>
                <p class="mt-1 text-sm text-slate-500">The verified email on your GitHub account. Only the organizers see it.</p>
            </div>

            <div>
                <label for="link" class="block font-medium text-slate-800">Your website or blog <span class="font-normal text-slate-500">(optional)</span></label>
                <InputText id="link" type="url" @bind-Value="Form!.Link" maxlength="200" placeholder="https://" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
                <p class="mt-1 text-sm text-slate-500">
                    On the calendar, your <strong>name</strong> links here, or to your GitHub profile if you leave it blank. It isn't
                    your article (you'll add that later, and the article title links to it), and it isn't a social media profile:
                    add those below.
                </p>
            </div>

            <div>
                <label for="comments" class="block font-medium text-slate-800">Comments <span class="font-normal text-slate-500">(optional)</span></label>
                <InputText id="comments" @bind-Value="Form!.Comments" maxlength="200" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
                <p class="mt-1 text-sm text-slate-500">Anything the organizers should know, such as a second-choice date.</p>
            </div>

            <fieldset class="rounded-xl p-4 ring-1 ring-slate-200">
                <legend class="px-1 font-medium text-slate-800">Social accounts <span class="font-normal text-slate-500">(optional)</span></legend>
                <p class="text-sm text-slate-600"><strong>If you add an account, we'll tag you there when we post about your article on that service</strong>, and link to it from your article's page here. Leave any blank that you don't use. They're saved to your <a href="profile" class="text-advent-700 underline">profile</a> for next time.</p>
                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                    <label class="flex flex-col text-sm font-medium text-slate-700">
                        Bluesky
                        <InputText @bind-Value="Form!.Bluesky" maxlength="253" placeholder="you.bsky.social" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
                    </label>
                    <label class="flex flex-col text-sm font-medium text-slate-700">
                        Mastodon
                        <InputText @bind-Value="Form!.Mastodon" maxlength="100" placeholder="@("@you@mastodon.social")" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
                    </label>
                    <label class="flex flex-col text-sm font-medium text-slate-700">
                        LinkedIn
                        <InputText @bind-Value="Form!.LinkedIn" maxlength="200" placeholder="https://www.linkedin.com/in/you" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
                    </label>
                    <label class="flex flex-col text-sm font-medium text-slate-700">
                        Facebook
                        <InputText @bind-Value="Form!.Facebook" maxlength="200" placeholder="https://www.facebook.com/you" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
                    </label>
                    <label class="flex flex-col text-sm font-medium text-slate-700">
                        Reddit
                        <InputText @bind-Value="Form!.Reddit" maxlength="40" placeholder="u/you" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
                    </label>
                    <label class="flex flex-col text-sm font-medium text-slate-700">
                        X
                        <InputText @bind-Value="Form!.X" maxlength="100" placeholder="@("@you")" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
                    </label>
                </div>
            </fieldset>

            <div class="flex flex-col gap-4 rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
                <label class="flex items-start gap-3">
                    <InputCheckbox @bind-Value="Form!.AgreeToTiming" class="mt-1 size-4" />
                    <span>
                        I'll publish my post on December @Day.
                        <details class="mt-1 text-sm text-slate-600">
                            <summary class="cursor-pointer text-advent-700">What this means</summary>
                            Things happen, and sometimes people need to back out. If you can't deliver your post, let the organizers
                            know as soon as you can. If your post isn't ready in time, your spot may go to someone on the backup list.
                        </details>
                    </span>
                </label>
                @if (BlurbRules.AppliesTo(Year))
                {
                    var blurb = SuggestedBlurb.For(Year, _slot!.SlotsPerDay);
                    <div class="text-sm text-slate-700">
                        <p>
                            <strong class="text-slate-900">Your post opens with the C# Advent blurb.</strong> Any wording works, as long
                            as it says the post is part of the @Year C# Advent calendar and links to @BlurbRules.Host. For example:
                        </p>
                        <blockquote class="mt-2 rounded-lg border-l-4 border-advent-600 bg-white px-3 py-2 text-slate-800">
                            This post is part of the <a href="@BlurbRules.SiteUrl" class="text-advent-700 underline">@blurb.Calendar</a>: @blurb.Rest
                        </blockquote>
                        <p class="mt-2 text-slate-600">
                            We check every post, and one without it when it's announced may go to a backup poster. Once you have a
                            spot, this example is ready to copy on your My spots page.
                        </p>
                    </div>
                }
                <label class="flex items-start gap-3">
                    <InputCheckbox @bind-Value="Form!.AgreeToTerms" class="mt-1 size-4" />
                    <span>
                        I agree to the terms.
                        <details class="mt-1 text-sm text-slate-600">
                            <summary class="cursor-pointer text-advent-700">What you're agreeing to</summary>
                            Your post is about C#, it's your own work, and it opens with the C# Advent blurb, linking back to the
                            calendar. We email you only about
                            C# Advent and never sell your information. Emails about your spot always come; the rest have a
                            link to unsubscribe. We keep your email address after the season to tell you when the next one
                            opens; ask us and we'll delete it.
                            Read the full <a href="terms" target="_blank" class="text-advent-700 underline">terms</a> and
                            <a href="privacy" target="_blank" class="text-advent-700 underline">privacy page</a> (they open in a new tab).
                        </details>
                    </span>
                </label>
            </div>

            <div>
                <button type="submit" class="rounded-lg bg-advent-600 px-5 py-3 font-semibold text-white shadow hover:bg-advent-700">Request this spot</button>
            </div>
        </EditForm>
    }
}

@code {
    private ClaimableSlot? _slot;
    private string? _email;
    private int _contributorId;
    private string? _error;
    private int _pending;

    [Parameter]
    public int Year { get; set; }

    [Parameter]
    public int Day { get; set; }

    [Parameter]
    public int Part { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "claim")]
    private ClaimForm? Form { get; set; }

    private bool _posted;

    private bool CanRequest => _slot is { Availability: ClaimAvailability.Open } && _email is not null && _pending < Claims.MaxPendingPerSeason;

    protected override async Task OnInitializedAsync()
    {
        // Static rendering starts at the first wait, so the form needs its model first. The model is only supplied when the
        // form was posted.
        _posted = Form is not null;
        Form ??= new ClaimForm();

        var user = (await AuthenticationState).User;
        _contributorId = user.GetContributorId() ?? 0;
        var claimant = await Claims.GetClaimantAsync(_contributorId);
        _email = claimant?.VerifiedEmail;

        // A new form starts with their profile's name, link and accounts (or their GitHub name); a posted form keeps what was typed.
        if (!_posted)
        {
            Form.DisplayName = Truncate(claimant?.DisplayName ?? user.GetDisplayName(), 50);
            Form.Link = claimant?.WebsiteUrl;
            Form.Bluesky = claimant?.Bluesky;
            Form.Mastodon = claimant?.Mastodon;
            Form.LinkedIn = claimant?.LinkedIn;
            Form.Facebook = claimant?.Facebook;
            Form.Reddit = claimant?.Reddit;
            Form.X = claimant?.X;
        }

        _slot = await Claims.FindAsync(Year, Day, Part);
        if (_slot is null)
        {
            Navigation.NotFound();
            return;
        }

        _pending = await Claims.CountPendingAsync(_contributorId, Year);
    }

    private static string Truncate(string text, int length) => text.Length <= length ? text : text[..length];

    private async Task SubmitAsync()
    {
        switch (await Claims.SubmitAsync(_contributorId, Year, Day, Part, Form!))
        {
            case ClaimOutcome.Submitted:
                Navigation.NavigateTo($"claim/requested/{Year}/{Day}/{Part}");
                break;
            case ClaimOutcome.AlreadyRequested:
                _error = "You've already requested this spot. The organizers will be in touch.";
                break;
            case ClaimOutcome.NoVerifiedEmail:
                _email = null;
                break;
            case ClaimOutcome.TooManyPending:
                _pending = await Claims.CountPendingAsync(_contributorId, Year);
                break;
            case ClaimOutcome.TooManyThisHour:
                _error = $"You've asked for a lot of spots in the last hour. Try again later, or email {Site.Value.ContactEmail}.";
                break;
            default:
                _slot = await Claims.FindAsync(Year, Day, Part);
                break;
        }
    }
}
