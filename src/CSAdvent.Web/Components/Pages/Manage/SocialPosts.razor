@page "/manage/social"
@using System.Globalization
@using CSAdvent.Web.Claims
@using CSAdvent.Web.Data
@using CSAdvent.Web.Social
@using CSAdvent.Web.Social.Posting
@using Microsoft.Extensions.Options
@inject SeasonAdminService Seasons
@inject SocialService Social
@inject SocialPlatformModes Modes
@inject IOptions<SocialPostingOptions> Posting
@inject AdventSchedule Schedule
@inject TimeProvider Clock

<PageTitle>Social · Manage · C# Advent</PageTitle>

<ManageNav />

@if (_day is { } day)
{
    <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">Announcements for December @day.Day, @day.Year</h1>
        <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium">
            <a href="@($"{DayLink(day.Year, day.Day)}#platforms")" class="text-advent-700 underline">How each platform is posted ↓</a>
            <a href="manage/social/signups" class="text-advent-700 underline">Sign-ups posts →</a>
        </p>
    </div>
    <PastSeasonNotice Year="day.Year" />
    <p class="mt-2 max-w-3xl text-slate-600">
        One post per entry on each platform, with the same content everywhere. Copy each one (or open the composer where
        there is one), post it, then mark it posted. Links go to the entry's page, tagged with the platform.
    </p>

    @if (ErrorMessage is { } error)
    {
        <p class="mt-4 rounded-xl bg-red-50 p-4 font-medium text-red-800 ring-1 ring-red-200" role="alert">@error</p>
    }

    <nav aria-label="Days" class="mt-6 flex flex-wrap gap-1 text-sm font-medium">
        @for (var d = 1; d <= Season.DaysInAdvent; d++)
        {
            <a href="@DayLink(day.Year, d)"
               aria-current="@(d == day.Day ? "page" : null)"
               class="rounded-md px-2.5 py-1 tabular-nums @(d == day.Day ? "bg-slate-900 text-white" : d == _today ? "text-advent-700 ring-1 ring-advent-500" : "text-slate-600 ring-1 ring-slate-200 hover:bg-slate-100")">@d</a>
        }
    </nav>

    @if (!day.IsRevealed)
    {
        <p class="mt-6 rounded-xl bg-amber-50 p-4 text-amber-900 ring-1 ring-amber-200">
            Preview only: December @day.Day's posts are revealed at midnight (<LocalTime Value="day.RevealsAt" />), so
            nothing can be posted before then. Platforms set to Automatic then post them at @Time(1) (post 1) and @Time(2) (post 2);
            you can post by hand any time after the reveal.
        </p>
    }

    @if (day.Entries.Count == 0)
    {
        <p class="mt-8 text-slate-500">No posts for this day yet. Entries appear here once they have a title and URL.</p>
    }

    @foreach (var entry in day.Entries)
    {
        <section class="mt-10">
            <h2 class="text-xl font-semibold text-slate-900">Post @entry.Part: @entry.Title <span class="font-normal text-slate-500">by @entry.Author</span></h2>
            @if (entry.Blurb is { } blurb)
            {
                <p class="mt-1 flex flex-wrap items-center gap-2 text-sm">
                    <span title="@blurb.Detail" class="rounded-full px-2 py-0.5 text-xs font-semibold @CSAdvent.Web.Blurbs.Labels.Badge(blurb.Status)">@blurb.Label</span>
                    @if (!entry.CanAnnounce)
                    {
                        <span class="text-slate-600">Not posted automatically until its blurb check passes.</span>
                    }
                    <a href="manage/entries/@entry.SlotId" class="font-medium text-advent-700 underline">Check or decide</a>
                </p>
            }

            <div class="mt-4 grid gap-4 lg:grid-cols-2">
                @foreach (var platform in entry.Platforms.Where(p => ModeOf(p.Platform) is not SocialPostingMode.Off))
                {
                    var id = $"announcement-{entry.SlotId}-{platform.Platform}";
                    // Its buttons come back to it, not to the top of the page (#170).
                    var back = $"{DayLink(day.Year, day.Day)}#{id}-card";
                    var posted = entry.Posted.GetValueOrDefault(platform.Platform);
                    var automatic = _platforms.Single(p => p.Platform == platform.Platform).IsAutomatic && day.Year != Season.TestYear;
                    var byAutomation = posted?.MarkedBy == SocialPostingService.Automation;
                    <article id="@($"{id}-card")" class="flex min-w-0 scroll-mt-4 flex-col rounded-xl p-4 ring-1 @(posted?.Status switch { SocialPostStatus.Posted => "bg-green-50 ring-green-200", SocialPostStatus.Unconfirmed => "bg-amber-50 ring-amber-200", _ => "bg-white ring-slate-200" })">
                        <header class="flex items-center justify-between gap-2">
                            <h3 class="font-semibold text-slate-900">@platform.Platform</h3>
                            @if (platform.Limit is { } limit)
                            {
                                <span class="text-xs tabular-nums @(platform.Length > limit ? "font-semibold text-red-700" : "text-slate-500")">@platform.Length / @limit</span>
                            }
                        </header>

                        @if (platform.Platform is SocialPlatform.Reddit)
                        {
                            <p class="mt-2 text-xs font-medium uppercase tracking-wide text-slate-500">Title</p>
                        }
                        <pre id="@id" class="mt-1 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-3 font-sans text-sm text-slate-800 ring-1 ring-slate-100">@platform.Text</pre>
                        @if (platform.Platform is SocialPlatform.Reddit)
                        {
                            <p class="mt-2 text-xs font-medium uppercase tracking-wide text-slate-500">Link</p>
                            <pre id="@($"{id}-link")" class="mt-1 whitespace-pre-wrap break-all rounded-lg bg-slate-50 p-3 font-sans text-sm text-slate-800 ring-1 ring-slate-100">@platform.Link</pre>
                        }
                        @if (platform.TagHint is { } hint)
                        {
                            <p class="mt-2 text-sm text-slate-600">@hint</p>
                        }

                        <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
                            <button type="button" data-copy="@id" class="rounded-lg bg-advent-600 px-3 py-1.5 font-semibold text-white hover:bg-advent-700">Copy@(platform.Platform is SocialPlatform.Reddit ? " title" : "")</button>
                            @if (platform.Platform is SocialPlatform.Reddit)
                            {
                                <button type="button" data-copy="@($"{id}-link")" class="rounded-lg px-3 py-1.5 font-medium text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50">Copy link</button>
                            }
                            @if (day.IsRevealed && platform.ComposerUrl is { } composer)
                            {
                                <a href="@composer" target="_blank" rel="noopener" class="rounded-lg px-3 py-1.5 font-medium text-advent-700 ring-1 ring-advent-300 hover:bg-advent-50">Open composer</a>
                            }
                        </div>

                        <div class="mt-auto pt-4">
                            @if (posted is { Status: SocialPostStatus.Posted } && byAutomation)
                            {
                                <p class="text-sm text-green-900">
                                    Posted automatically, <LocalTime Value="posted.At" />
                                    @if (posted.PostUrl is { } postUrl)
                                    {
                                        <a href="@postUrl" target="_blank" rel="noopener" class="ml-1 underline">view</a>
                                    }
                                </p>
                            }
                            else if (posted is { Status: SocialPostStatus.Posting })
                            {
                                <p class="text-sm font-medium text-slate-700">Posting now…</p>
                            }
                            else if (posted is { Status: SocialPostStatus.Posted })
                            {
                                <form method="post" action="manage/social/unmark" class="flex flex-wrap items-center gap-2 text-sm text-green-900">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="SlotId" value="@entry.SlotId" />
                                    <input type="hidden" name="Platform" value="@platform.Platform" />
                                    <input type="hidden" name="ReturnUrl" value="@back" />
                                    <span>
                                        Posted by @posted.MarkedBy, <LocalTime Value="posted.At" />
                                        @if (posted.PostUrl is { } postUrl)
                                        {
                                            <a href="@postUrl" target="_blank" rel="noopener" class="ml-1 underline">view</a>
                                        }
                                    </span>
                                    <button type="submit" class="ml-auto rounded-md px-2 py-1 text-slate-600 ring-1 ring-slate-300 hover:bg-white">Undo</button>
                                </form>
                            }
                            else
                            {
                                @if (posted is { Status: SocialPostStatus.Unconfirmed })
                                {
                                    @* It may have gone out (#154): checking comes before retrying, which could post it twice. *@
                                    <form method="post" action="manage/social/retry" class="mb-3 text-sm text-amber-900">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="SlotId" value="@entry.SlotId" />
                                        <input type="hidden" name="Platform" value="@platform.Platform" />
                                        <input type="hidden" name="ReturnUrl" value="@back" />
                                        <p><span class="font-semibold">Did it go out?</span> @platform.Platform never said: @posted.Error</p>
                                        <p class="mt-1">
                                            Look for it on C# Advent's @platform.Platform account before trying again. If it's there, mark it
                                            posted below; if it isn't, retry it.
                                        </p>
                                        <button type="submit" class="mt-2 rounded-md bg-white px-2 py-1 font-medium text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50">Retry now</button>
                                    </form>
                                }
                                else if (posted is { Status: SocialPostStatus.Failed })
                                {
                                    <form method="post" action="manage/social/retry" class="mb-3 flex flex-wrap items-center gap-2 text-sm text-red-700">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="SlotId" value="@entry.SlotId" />
                                        <input type="hidden" name="Platform" value="@platform.Platform" />
                                        <input type="hidden" name="ReturnUrl" value="@back" />
                                        <span>Automatic posting failed (@Plural(posted.Attempts, "try", "tries")): @posted.Error</span>
                                        <button type="submit" class="rounded-md bg-white px-2 py-1 font-medium text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50">Retry now</button>
                                    </form>
                                }
                                else if (automatic)
                                {
                                    <p class="mb-2 text-sm text-slate-600">@(entry.CanAnnounce ? AutomaticNote(day, entry.Part) : "Waiting for its blurb check before it's posted automatically. Or post it by hand and mark it below.")</p>
                                }
                                <form method="post" action="manage/social/mark" class="flex flex-wrap items-center gap-2 text-sm">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="SlotId" value="@entry.SlotId" />
                                    <input type="hidden" name="Platform" value="@platform.Platform" />
                                    <input type="hidden" name="ReturnUrl" value="@back" />
                                    <input type="url" name="PostUrl" placeholder="Link to the post (optional)" aria-label="@($"Link to the {platform.Platform} post (optional)")" maxlength="500" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-2 py-1" />
                                    <button type="submit" disabled="@(!day.IsRevealed)" class="rounded-lg px-3 py-1.5 font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50">Mark as posted</button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @* After the posts, which are what organizers come for each day, and its buttons come back here. *@
    <div id="platforms" class="mt-12 scroll-mt-4">
        <SocialPostingPanel Platforms="_platforms" ReturnUrl="@($"{DayLink(day.Year, day.Day)}#platforms")" />
    </div>
}
else if (_loaded)
{
    <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">Announcements</h1>
        <a href="manage/social/signups" class="text-sm font-medium text-advent-700 underline">Sign-ups posts →</a>
    </div>
    @if (ErrorMessage is { } error)
    {
        <p class="mt-4 rounded-xl bg-red-50 p-4 font-medium text-red-800 ring-1 ring-red-200" role="alert">@error</p>
    }

    <NoCurrentSeason />
    <SocialPostingPanel Platforms="_platforms" ReturnUrl="manage/social" />
}

@code {
    private AnnouncementDay? _day;
    private int? _today;
    private bool _loaded;

    [SupplyParameterFromQuery]
    public int? Year { get; set; }

    [SupplyParameterFromQuery(Name = "day")]
    public int? DayOfAdvent { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private IReadOnlyList<PlatformPosting> _platforms = [];

    private string? ErrorMessage => Error switch
    {
        "not-revealed" => "That entry isn't revealed yet, so it can't be posted.",
        "no-credentials" => "That platform has no credentials, so it can't post automatically.",
        "retry-failed" => "Retrying didn't work. The post shows the platform's error.",
        "retry-unconfirmed" => "The platform never said whether the retry went out. Look for it on the account before trying again.",
        "test-failed" => "The test post didn't go out. The platform's error is next to it, under How each platform is posted.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        _loaded = true;
        _platforms = await Modes.GetAsync();
        if ((Year ?? await Seasons.GetCurrentYearAsync()) is not { } year)
        {
            return;
        }

        // Today, during Advent; otherwise the first day before it starts, or the last one after.
        var today = Schedule.Today;
        _today = Schedule.GetDayOfAdvent(year, today);
        var day = Math.Clamp(DayOfAdvent ?? _today ?? (today < Schedule.GetDate(year, 1) ? 1 : Season.DaysInAdvent), 1, Season.DaysInAdvent);
        _day = await Social.GetDayAsync(year, day);
    }

    private SocialPostingMode ModeOf(SocialPlatform platform) => _platforms.SingleOrDefault(p => p.Platform == platform)?.Mode ?? SocialPostingMode.Manual;

    /// <summary>When an entry not posted yet goes out on a platform in Automatic mode. Only on its day, so never once that's passed.</summary>
    private string AutomaticNote(AnnouncementDay day, int part)
    {
        var date = Schedule.GetDate(day.Year, day.Day);
        if (Schedule.Today > date)
        {
            return "Its day has passed, so it isn't posted automatically. Post it by hand if it should still go out.";
        }

        var due = Schedule.Today == date && TimeOnly.FromDateTime(Schedule.ToLocalTime(Clock.GetUtcNow()).DateTime) >= Posting.Value.TimeFor(part);
        return due
            ? "Posts automatically within a few minutes. Or post it by hand and mark it below."
            : $"Posts automatically at {Time(part)} Eastern on December {day.Day}. Or post it by hand and mark it below.";
    }

    /// <summary>"10 AM", or "2:30 PM".</summary>
    private string Time(int part) =>
        Posting.Value.TimeFor(part) is var time && time.Minute == 0
            ? time.ToString("h tt", CultureInfo.InvariantCulture)
            : time.ToString("h:mm tt", CultureInfo.InvariantCulture);

    private static string Plural(int count, string one, string many) => string.Create(CultureInfo.InvariantCulture, $"{count} {(count == 1 ? one : many)}");

    private static string DayLink(int year, int day) => $"manage/social?year={year}&day={day}";
}
