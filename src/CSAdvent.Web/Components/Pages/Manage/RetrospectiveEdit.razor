@page "/manage/retrospectives/{Year:int}"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using CSAdvent.Web.Components.Retrospectives
@using CSAdvent.Web.Data
@using CSAdvent.Web.Retrospectives
@using CSAdvent.Web.Social.Posting
@inject RetrospectiveService Retrospectives
@inject SeasonSocialService SeasonPosts
@inject NavigationManager Navigation

<PageTitle>C# Advent @Year retrospective · Manage · C# Advent</PageTitle>

<ManageNav />

<nav class="mb-4 text-sm font-medium"><a href="manage/retrospectives" class="text-advent-700 hover:underline">← All retrospectives</a></nav>

@if (Message is { } message)
{
    <p class="mb-6 max-w-3xl rounded-xl bg-green-50 p-4 font-medium text-green-800 ring-1 ring-green-200" role="status">@message</p>
}

@if (_error is { } error)
{
    <p class="mb-6 max-w-3xl rounded-xl bg-red-50 p-4 font-medium text-red-800 ring-1 ring-red-200" role="alert">@error</p>
}

@if (_loaded && !_finished)
{
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Retrospective</h1>
    <p class="mt-2 text-slate-600">There's no finished season @Year. A season gets a retrospective once its last day is revealed.</p>
}
else if (_loaded && _retrospective is null)
{
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">C# Advent @Year retrospective</h1>
    <p class="mt-2 max-w-3xl text-slate-600">
        Start with a draft written from the season's numbers: its posts and authors, first-time and returning authors, and, from
        2026 on, its clicks and most-read posts. You can rewrite all of it before publishing.
    </p>
    <EditForm Model="Generate" FormName="generate" OnSubmit="GenerateAsync" class="mt-6">
        <button type="submit" class="rounded-lg bg-advent-600 px-4 py-2 font-semibold text-white hover:bg-advent-700">Generate the draft</button>
    </EditForm>
}
else if (_retrospective is { } retrospective)
{
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">C# Advent @Year retrospective</h1>
    <p class="mt-2 max-w-3xl text-slate-600">
        @if (retrospective.PublishedAt is { } publishedAt)
        {
            <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-800">Published</span>
            <text> <LocalTime Value="publishedAt" />, at </text>
            <a href="@RetrospectiveLinks.Page(Year)" class="text-advent-700 underline">@RetrospectiveLinks.Page(Year)</a><text>. Edits show on it as soon as they're saved.</text>
        }
        else
        {
            <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">Draft</span>
            <text> Only organizers can see it until it's published.</text>
        }
        Last saved <LocalTime Value="retrospective.UpdatedAt" /> by @retrospective.UpdatedBy. The numbers are as of <LocalTime Value="retrospective.StatsAt" />.
    </p>

    <EditForm Model="Form" FormName="retrospective" OnValidSubmit="SaveAsync" class="mt-6 flex max-w-3xl flex-col gap-4">
        <DataAnnotationsValidator />
        <ValidationSummary class="rounded-xl bg-red-50 p-4 text-sm ring-1 ring-red-200" />
        <input type="hidden" name="Form.Version" value="@Form!.Version" />
        <label class="flex flex-col text-sm font-medium text-slate-700">
            Title
            <InputText @bind-Value="Form!.Title" maxlength="150" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
        </label>
        <label class="flex flex-col text-sm font-medium text-slate-700">
            The post
            <span class="font-normal text-slate-500">Markdown: <code>## Heading</code>, <code>- list item</code>, <code>**bold**</code>, <code>[text](https://…)</code>. A blank line starts a new paragraph.</span>
            <InputTextArea @bind-Value="Form!.Body" rows="24" maxlength="20000" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm font-normal" />
        </label>
        <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
            <InputCheckbox @bind-Value="Form!.ShowCharts" />
            Show the charts after the post
        </label>
        <div>
            <button type="submit" class="rounded-lg bg-white px-4 py-2 font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50">Save</button>
        </div>
    </EditForm>

    <div class="mt-8 flex max-w-3xl flex-col gap-4">
        <EditForm Model="Publication" FormName="publication" OnSubmit="PublicationAsync" class="rounded-xl bg-advent-50 p-4 ring-1 ring-advent-200">
            <input type="hidden" name="Publication.Publish" value="@(retrospective.IsPublished ? "false" : "true")" />
            @if (retrospective.IsPublished)
            {
                <p class="text-sm text-slate-600">Unpublishing takes the page down and drops it from the RSS feed, until it's published again.</p>
                <button type="submit" class="mt-3 rounded-lg bg-white px-4 py-2 font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50">Unpublish</button>
            }
            else
            {
                <p class="text-sm text-slate-600">
                    Publishing puts it at <strong>@RetrospectiveLinks.Page(Year)</strong>, links it from the season's archive page,
                    and adds it to the RSS feed. Then share it from here.
                </p>
                <button type="submit" class="mt-3 rounded-lg bg-advent-600 px-4 py-2 font-semibold text-white hover:bg-advent-700">Publish</button>
            }
        </EditForm>

        @if (!retrospective.IsPublished)
        {
            <EditForm Model="Generate" FormName="generate" OnSubmit="GenerateAsync" class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
                <label class="flex items-center gap-2 text-sm text-slate-700">
                    <InputCheckbox @bind-Value="Generate!.Confirm" />
                    Replace the post and the numbers with a new draft from today's numbers
                </label>
                <button type="submit" class="mt-3 rounded-lg bg-white px-4 py-2 text-sm font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-100">Generate a new draft</button>
            </EditForm>
        }
    </div>

    @if (_shares is { } shares)
    {
        <section class="mt-12">
            <h2 class="text-xl font-semibold text-slate-900">Share it</h2>
            <p class="mt-1 max-w-3xl text-sm text-slate-600">
                Links go to the retrospective, tagged with the platform. Platforms that can post automatically have a Post now
                button; copy it for the rest. Each platform gets it once.
            </p>
            @if (Error == "not-posted")
            {
                <p class="mt-4 max-w-3xl rounded-xl bg-red-50 p-4 font-medium text-red-800 ring-1 ring-red-200" role="alert">
                    That didn't go out. The post shows the platform's error, if it gave one.
                </p>
            }
            <div class="mt-4 grid gap-4 lg:grid-cols-2">
                @foreach (var platform in shares)
                {
                    <SeasonPostCard Year="Year" Kind="SeasonPostKind.Retrospective" Post="platform" CanPost="true" />
                }
            </div>
        </section>
    }

    <section class="mt-12">
        <h2 class="text-xl font-semibold text-slate-900">Preview</h2>
        <p class="mt-1 text-sm text-slate-600">As readers will see it, from the last save.</p>
        <div class="mt-4 rounded-2xl bg-white p-6 ring-1 ring-slate-200 sm:p-10">
            <RetrospectiveArticle Retrospective="retrospective" />
        </div>
    </section>
}

@code {
    private Retrospective? _retrospective;
    private IReadOnlyList<SeasonPostPlatform>? _shares;
    private bool _finished;
    private bool _loaded;
    private string? _error;

    [Parameter]
    public int Year { get; set; }

    [SupplyParameterFromQuery(Name = "done")]
    public string? Done { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "retrospective")]
    private RetrospectiveForm? Form { get; set; }

    [SupplyParameterFromForm(FormName = "generate")]
    private GenerateForm? Generate { get; set; }

    [SupplyParameterFromForm(FormName = "publication")]
    private PublicationForm? Publication { get; set; }

    private string? Message => Done switch
    {
        "generated" => "The draft is ready. Read it through, change what you like, and save.",
        "saved" => "Saved.",
        "published" => "Published. Share it below.",
        "unpublished" => "Unpublished: the page is down until it's published again.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        // Static rendering starts at the first await, so the forms need their models first.
        var posted = Form is not null;
        Form ??= new();
        Generate ??= new();
        Publication ??= new();

        _finished = await Retrospectives.IsFinishedSeasonAsync(Year);
        _retrospective = _finished ? await Retrospectives.GetAsync(Year) : null;
        if (_retrospective is { } retrospective)
        {
            // A posted form keeps what was typed; a fresh page starts from what's saved.
            if (!posted)
            {
                Form = RetrospectiveForm.From(retrospective);
            }

            if (retrospective.IsPublished)
            {
                _shares = await SeasonPosts.GetRetrospectiveAsync(Year);
            }
        }

        _loaded = true;
    }

    private async Task SaveAsync()
    {
        switch (await Retrospectives.SaveAsync(Year, Form!, await UserAsync()))
        {
            case RetrospectiveOutcome.Saved:
                Navigation.NavigateTo($"manage/retrospectives/{Year}?done=saved");
                break;
            case RetrospectiveOutcome.ChangedByOthers:
                _error = "Another organizer saved it since you opened it, so your changes weren't saved. Copy them, reload the page and add them again.";
                break;
            default:
                _error = "There's nothing to save: generate the draft first.";
                break;
        }
    }

    private async Task GenerateAsync()
    {
        if (_retrospective is not null && !Generate!.Confirm)
        {
            _error = "Tick the box to replace the post and the numbers with a new draft.";
            return;
        }

        switch (await Retrospectives.GenerateAsync(Year, await UserAsync()))
        {
            case RetrospectiveOutcome.Saved:
                Navigation.NavigateTo($"manage/retrospectives/{Year}?done=generated");
                break;
            case RetrospectiveOutcome.AlreadyPublished:
                _error = "It's published, so it can't be replaced. Unpublish it first.";
                break;
            case RetrospectiveOutcome.ChangedByOthers:
                _error = "Another organizer changed it at the same moment. Reload the page and try again.";
                break;
            default:
                _error = "There's no finished season to write about.";
                break;
        }
    }

    private async Task PublicationAsync()
    {
        if (Publication!.Publish)
        {
            await Retrospectives.PublishAsync(Year);
            Navigation.NavigateTo($"manage/retrospectives/{Year}?done=published");
        }
        else
        {
            await Retrospectives.UnpublishAsync(Year);
            Navigation.NavigateTo($"manage/retrospectives/{Year}?done=unpublished");
        }
    }

    private async Task<string> UserAsync() => (await AuthenticationState).User.Identity?.Name ?? "organizer";

    private sealed class GenerateForm
    {
        public bool Confirm { get; set; }
    }

    private sealed class PublicationForm
    {
        public bool Publish { get; set; }
    }
}
