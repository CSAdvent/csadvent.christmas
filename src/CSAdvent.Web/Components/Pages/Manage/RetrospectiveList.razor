@page "/manage/retrospectives"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using CSAdvent.Web.Retrospectives
@inject RetrospectiveService Retrospectives
@inject NavigationManager Navigation

<PageTitle>Retrospectives · Manage · C# Advent</PageTitle>

<ManageNav />

<h1 class="text-3xl font-bold tracking-tight text-slate-900">Retrospectives</h1>
<p class="mt-2 max-w-3xl text-slate-600">
    After each season, a look back at it: a page in the season's archive with its numbers and charts, linked from the season,
    in the RSS feed, and ready to share. Generate a draft from the numbers, rewrite it as you like, and publish it when you're
    ready (late December or early January). Generate it before February 1, when the season's requests and backup list are
    deleted, or those numbers will be missing.
</p>

@if (Message is { } message)
{
    <p class="mt-6 max-w-3xl rounded-xl bg-green-50 p-4 font-medium text-green-800 ring-1 ring-green-200" role="status">@message</p>
}

<ul class="mt-8 flex max-w-3xl flex-col gap-3">
    @foreach (var season in _seasons)
    {
        <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl p-4 ring-1 ring-slate-200">
            <div>
                <p class="font-semibold text-slate-900">C# Advent @season.Year <span class="font-normal text-slate-500">· @season.Posts posts</span></p>
                <p class="mt-1 text-sm">
                    @if (season.PublishedAt is { } publishedAt)
                    {
                        <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-800">Published</span>
                        <span class="ml-1 text-slate-500"><LocalTime Value="publishedAt" /></span>
                        <a href="@RetrospectiveLinks.Page(season.Year)" class="ml-2 text-advent-700 underline">View</a>
                    }
                    else if (season.UpdatedAt is { } updatedAt)
                    {
                        <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">Draft</span>
                        <span class="ml-1 text-slate-500">saved <LocalTime Value="updatedAt" /></span>
                    }
                    else
                    {
                        <span class="text-slate-500">No retrospective yet</span>
                    }
                </p>
            </div>
            <a href="manage/retrospectives/@season.Year" class="rounded-lg px-3 py-1.5 text-sm font-semibold text-advent-700 ring-1 ring-advent-300 hover:bg-advent-50">
                @(season.HasDraft ? "Open" : "Write it")
            </a>
        </li>
    }
</ul>

@if (_missing > 0 || Backfill is { Posted: true })
{
    <EditForm Model="Backfill" FormName="backfill" OnSubmit="BackfillAsync" class="mt-8 max-w-3xl rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
        <input type="hidden" name="Backfill.Posted" value="true" />
        <p class="text-sm text-slate-600">
            Write a draft from the numbers for @Plural(_missing, "season") without one. Seasons before 2026 have no visit or click
            data, so theirs cover the posts and authors. Nothing is public until it's published.
        </p>
        <button type="submit" class="mt-3 rounded-lg bg-white px-4 py-2 font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-100">Generate @Plural(_missing, "draft")</button>
    </EditForm>
}

@if (_drafts > 0 || PublishAll is { Posted: true })
{
    <EditForm Model="PublishAll" FormName="publish-all" OnValidSubmit="PublishAllAsync" class="mt-4 max-w-3xl rounded-xl bg-advent-50 p-4 ring-1 ring-advent-200">
        <DataAnnotationsValidator />
        <input type="hidden" name="PublishAll.Posted" value="true" />
        <label class="flex items-center gap-2 text-sm font-medium text-slate-800">
            <InputCheckbox @bind-Value="PublishAll!.Confirm" />
            Publish all @Plural(_drafts, "draft") now, as they are
        </label>
        <ValidationMessage For="() => PublishAll!.Confirm" class="mt-1 text-sm" />
        <p class="mt-1 text-sm text-slate-600">Each becomes a public page in its season's archive and an item in the RSS feed.</p>
        <button type="submit" class="mt-3 rounded-lg bg-advent-600 px-4 py-2 font-semibold text-white hover:bg-advent-700">Publish @Plural(_drafts, "draft")</button>
    </EditForm>
}

@code {
    private IReadOnlyList<RetrospectiveSeason> _seasons = [];
    private int _missing;
    private int _drafts;

    [SupplyParameterFromQuery(Name = "done")]
    public string? Done { get; set; }

    [SupplyParameterFromQuery(Name = "count")]
    public int? Count { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "backfill")]
    private PostedForm? Backfill { get; set; }

    [SupplyParameterFromForm(FormName = "publish-all")]
    private PublishAllForm? PublishAll { get; set; }

    private string? Message => Done switch
    {
        "generated" => $"Generated {Plural(Count ?? 0, "draft")}.",
        "published" => $"Published {Plural(Count ?? 0, "retrospective")}.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        // Static rendering starts at the first await, so the forms need their models first.
        Backfill ??= new();
        PublishAll ??= new();

        _seasons = await Retrospectives.ListAsync();
        _missing = _seasons.Count(s => !s.HasDraft);
        _drafts = _seasons.Count(s => s.HasDraft && s.PublishedAt is null);
    }

    private async Task BackfillAsync()
    {
        var by = (await AuthenticationState).User.Identity?.Name ?? "organizer";
        var generated = await Retrospectives.GenerateMissingAsync(by);
        Navigation.NavigateTo(string.Create(CultureInfo.InvariantCulture, $"manage/retrospectives?done=generated&count={generated}"));
    }

    private async Task PublishAllAsync()
    {
        var published = await Retrospectives.PublishDraftsAsync();
        Navigation.NavigateTo(string.Create(CultureInfo.InvariantCulture, $"manage/retrospectives?done=published&count={published}"));
    }

    private static string Plural(int count, string noun) => string.Create(CultureInfo.InvariantCulture, $"{count} {noun}{(count == 1 ? "" : "s")}");

    /// <summary>A form with no fields of its own: <see cref="Posted"/> keeps it rendered for its own post.</summary>
    private sealed class PostedForm
    {
        public bool Posted { get; set; }
    }

    private sealed class PublishAllForm
    {
        public bool Posted { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessage = "Tick the box to publish them all.")]
        public bool Confirm { get; set; }
    }
}
