@page "/manage/testing"
@using System.Globalization
@using CSAdvent.Web.SeasonTesting
@inject SeasonTestingService Testing
@inject AdventSchedule Schedule
@inject NavigationManager Navigation

<PageTitle>Testing · Manage · C# Advent</PageTitle>

<ManageNav />

<h1 class="text-3xl font-bold tracking-tight text-slate-900">Test season</h1>
<p class="mt-2 max-w-3xl text-slate-600">
    A hidden season for trying everything for real: claiming, approvals, adding posts, dropping out, the backup list,
    reminders, reveals and the daily email. Only the testers below and the organizers can see it, and it never touches the real
    seasons, so it can be used any time. A rehearsal puts its December 1 on a date you choose.
</p>

@if (Message is { } message)
{
    <p class="mt-4 max-w-3xl rounded-xl bg-slate-50 p-4 text-sm font-medium text-slate-800 ring-1 ring-slate-200" role="status">@message</p>
}

@if (_view is { } view)
{
    <section class="mt-8 max-w-3xl rounded-xl bg-amber-50 p-5 ring-1 ring-amber-200">
        <h2 class="text-xl font-semibold text-slate-900">Testing since @Format(view.StartedAt)</h2>
        <p class="mt-2 text-slate-700">
            In the rehearsal, today is <strong>@RehearsalDays.Describe(RehearsalDays.Today(Schedule.Today, view.RehearsalStartsOn))</strong>
            (its December 1 is @Format(view.RehearsalStartsOn)). It moves on a day at a time, like the real thing. Pick another
            day to jump ahead or go back: every day up to today is revealed, so it can't be claimed.
        </p>
        <EditForm Model="Move" FormName="move" OnValidSubmit="MoveAsync" class="mt-4 flex flex-wrap items-end gap-4">
            <DataAnnotationsValidator />
            <label class="flex flex-col text-sm font-medium text-slate-700">
                Make today
                <InputSelect @bind-Value="Move!.TodayIs" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal">
                    @foreach (var day in RehearsalDays.Choices)
                    {
                        <option value="@day">@RehearsalDays.Describe(day)</option>
                    }
                </InputSelect>
            </label>
            <button type="submit" class="rounded-lg bg-white px-4 py-2 font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50">Move the rehearsal</button>
            <ValidationSummary class="w-full text-sm text-red-700" />
        </EditForm>
        <p class="mt-3 text-sm text-slate-600">
            Post link reminders go out 7, 5, 3, 2 and 1 days before an author's day, backup asks from 6 PM the evening before, and
            the daily email at 9 AM on a day with posts.
        </p>

        <EditForm Model="Run" FormName="run" OnSubmit="RunAsync" class="mt-4">
            <button type="submit" class="rounded-lg bg-white px-4 py-2 font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50">Send due reminders and backup asks now</button>
            <span class="ml-2 text-sm text-slate-600">They also go out on their own every 15 minutes.</span>
        </EditForm>

        <p class="mt-5 text-slate-700">
            <a href="test-mode/on?returnUrl=%2F" class="font-semibold text-advent-700 underline">Switch to test mode</a>
            to see the test calendar on the home page. The test season's
            <a href="@($"manage/requests?year={TestYear}")" class="text-advent-700 underline">requests</a>,
            <a href="@($"manage/entries?year={TestYear}")" class="text-advent-700 underline">entries</a>,
            <a href="@($"manage/backups?year={TestYear}")" class="text-advent-700 underline">backup posters</a> and
            <a href="@($"manage/social?year={TestYear}")" class="text-advent-700 underline">announcements</a> are on the usual organizer pages.
        </p>
    </section>

    <section class="mt-8 max-w-3xl">
        <h2 class="text-xl font-semibold text-slate-900">Testers</h2>
        <p class="mt-1 text-slate-600">GitHub logins of the people invited to test. They see an invitation to switch to test mode once they've signed in. The organizers can always test.</p>
        @if (view.Testers.Count > 0)
        {
            <ul class="mt-4 flex flex-col divide-y divide-slate-100 rounded-xl ring-1 ring-slate-200">
                @foreach (var tester in view.Testers)
                {
                    <li class="flex items-center justify-between gap-4 p-3">
                        <a href="@($"https://github.com/{tester}")" class="font-medium text-advent-700 underline">@tester</a>
                        <form method="post" action="manage/testing/testers/remove">
                            <AntiforgeryToken />
                            <input type="hidden" name="Login" value="@tester" />
                            <button type="submit" class="rounded-md px-2 py-1 text-sm text-red-700 ring-1 ring-red-200 hover:bg-red-50">Remove</button>
                        </form>
                    </li>
                }
            </ul>
        }
        <EditForm Model="Tester" FormName="tester" OnValidSubmit="AddTesterAsync" class="mt-4 flex flex-wrap items-end gap-4">
            <DataAnnotationsValidator />
            <label class="flex flex-col text-sm font-medium text-slate-700">
                GitHub login
                <InputText @bind-Value="Tester!.Login" placeholder="octocat" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
            </label>
            <button type="submit" class="rounded-lg bg-white px-4 py-2 font-semibold text-slate-800 ring-1 ring-slate-300 hover:bg-slate-50">Add tester</button>
            <ValidationSummary class="w-full text-sm text-red-700" />
        </EditForm>
    </section>

    <section class="mt-10 max-w-3xl rounded-xl bg-red-50 p-5 ring-1 ring-red-200">
        <h2 class="text-xl font-semibold text-slate-900">Reset the test season</h2>
        <p class="mt-2 text-slate-700">
            Deletes everything done in it: @Plural(view.Activity.Spots, "spot") filled or dropped,
            @Plural(view.Activity.Requests, "request"), @Plural(view.Activity.BackupPosters, "backup poster"),
            @Plural(view.Activity.BackupOffers, "backup offer"), @Plural(view.Activity.Emails, "sent email record"),
            @Plural(view.Activity.Visits, "visit"), and @Plural(view.Activity.SocialPosts, "social post mark").
            Every spot is open again. The rehearsal and the testers stay.
        </p>
        <EditForm Model="Reset" FormName="reset" OnValidSubmit="ResetAsync" class="mt-4 flex flex-col gap-3">
            <DataAnnotationsValidator />
            <label class="flex items-center gap-2 text-sm font-medium text-slate-800">
                <InputCheckbox @bind-Value="Reset!.Confirm" />
                Delete everything done in the test season
            </label>
            <ValidationSummary class="text-sm text-red-700" />
            <div>
                <button type="submit" class="rounded-lg bg-red-700 px-4 py-2 font-semibold text-white hover:bg-red-800">Reset the test season</button>
            </div>
        </EditForm>
    </section>
}
else if (_loaded)
{
    <section class="mt-8 max-w-3xl rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
        <h2 class="text-xl font-semibold text-slate-900">Create the test season</h2>
        <p class="mt-2 text-slate-700">
            Choose what day today is in the rehearsal. Before December 1, testers can claim any day; you can jump ahead whenever
            you like.
        </p>
        <EditForm Model="Create" FormName="create" OnValidSubmit="CreateAsync" class="mt-4 flex flex-wrap items-end gap-4">
            <DataAnnotationsValidator />
            <label class="flex flex-col text-sm font-medium text-slate-700">
                Today is
                <InputSelect @bind-Value="Create!.TodayIs" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal">
                    @foreach (var day in RehearsalDays.Choices)
                    {
                        <option value="@day">@RehearsalDays.Describe(day)</option>
                    }
                </InputSelect>
            </label>
            <button type="submit" class="rounded-lg bg-advent-600 px-4 py-2 font-semibold text-white hover:bg-advent-700">Create the test season</button>
            <ValidationSummary class="w-full text-sm text-red-700" />
        </EditForm>
    </section>
}

@* Rendered (hidden) after an end post too, so a repeated post reaches its handler instead of getting a 400. *@
@if (_view is not null || _endPosted)
{
    <section hidden="@(_view is null)" class="mt-10 max-w-3xl rounded-xl bg-red-50 p-5 ring-1 ring-red-200">
        <h2 class="text-xl font-semibold text-slate-900">End testing</h2>
        <p class="mt-2 text-slate-700">
            Deletes the test season itself: its spots, its rehearsal, its testers and everything done in it. Nobody sees it any
            more, testers still in test mode just see the real site, and this page goes back to creating one. Create it again
            whenever you want another round.
        </p>
        <EditForm Model="End" FormName="end" OnValidSubmit="EndAsync" class="mt-4 flex flex-col gap-3">
            <DataAnnotationsValidator />
            <label class="flex items-center gap-2 text-sm font-medium text-slate-800">
                <InputCheckbox @bind-Value="End!.Confirm" />
                Delete the test season, its testers and everything done in it
            </label>
            <ValidationSummary class="text-sm text-red-700" />
            <div>
                <button type="submit" class="rounded-lg bg-red-700 px-4 py-2 font-semibold text-white hover:bg-red-800">End testing</button>
            </div>
        </EditForm>
    </section>
}

@code {
    private const int TestYear = CSAdvent.Web.Data.Season.TestYear;

    private TestingView? _view;
    private bool _loaded;

    [SupplyParameterFromQuery(Name = "done")]
    public string? Done { get; set; }

    [SupplyParameterFromForm(FormName = "create")]
    private RehearsalForm? Create { get; set; }

    [SupplyParameterFromForm(FormName = "move")]
    private RehearsalForm? Move { get; set; }

    [SupplyParameterFromForm(FormName = "tester")]
    private TesterForm? Tester { get; set; }

    [SupplyParameterFromForm(FormName = "run")]
    private RunForm? Run { get; set; }

    [SupplyParameterFromForm(FormName = "reset")]
    private ResetTestingForm? Reset { get; set; }

    [SupplyParameterFromForm(FormName = "end")]
    private EndTestingForm? End { get; set; }

    private bool _endPosted;

    private string? Message => Done switch
    {
        "created" => "The test season is ready. Invite the testers below, then send them to the site.",
        "moved" => "The rehearsal has moved.",
        "added" => "Tester added. They'll see an invitation to switch to test mode once they've signed in.",
        "removed" => "Tester removed.",
        "not-a-login" => "That isn't a GitHub login.",
        "ran" => "Due reminders and backup asks have gone out.",
        "reset" => "The test season has been reset, and everything done in it deleted.",
        "ended" => "Testing has ended. The test season, its testers and everything done in it are gone.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        // Static rendering starts at the first await, so the forms need their models first.
        Create ??= new RehearsalForm { TodayIs = -1 };
        Move ??= new RehearsalForm();
        Tester ??= new TesterForm();
        Run ??= new RunForm();
        Reset ??= new ResetTestingForm();
        _endPosted = End is not null;
        End ??= new EndTestingForm();

        _view = await Testing.GetAsync();
        Move.TodayIs ??= _view is null ? null : Math.Clamp(RehearsalDays.Today(Schedule.Today, _view.RehearsalStartsOn), RehearsalDays.Earliest, RehearsalDays.Latest);
        _loaded = true;
    }

    private async Task CreateAsync()
    {
        await Testing.CreateAsync(RehearsalDays.December1For(Schedule.Today, Create!.TodayIs!.Value));
        Back("created");
    }

    private async Task MoveAsync()
    {
        if (Move!.TodayIs is { } day)
        {
            await Testing.MoveAsync(RehearsalDays.December1For(Schedule.Today, day));
        }

        Back("moved");
    }

    private async Task AddTesterAsync() => Back(await Testing.AddTesterAsync(Tester!.Login) ? "added" : "not-a-login");

    private async Task RunAsync()
    {
        await Testing.RunNowAsync();
        Back("ran");
    }

    private async Task ResetAsync()
    {
        await Testing.ResetAsync();
        Back("reset");
    }

    private async Task EndAsync()
    {
        await Testing.EndAsync();
        Back("ended");
    }

    private void Back(string done) => Navigation.NavigateTo($"manage/testing?done={done}");

    private static string Format(DateOnly date) => date.ToString("dddd, MMMM d", CultureInfo.InvariantCulture);

    private string Format(DateTimeOffset moment) => Schedule.ToLocalTime(moment).ToString("MMMM d 'at' h:mm tt", CultureInfo.InvariantCulture);

    private static string Plural(int count, string noun) => string.Create(CultureInfo.InvariantCulture, $"{count} {noun}{(count == 1 ? "" : "s")}");

    /// <summary>The run form has no fields; it only needs a model.</summary>
    private sealed class RunForm;
}
