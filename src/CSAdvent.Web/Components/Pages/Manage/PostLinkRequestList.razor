@page "/manage/authors/link-changes"
@using CSAdvent.Web.Contributors
@inject PostLinkService PostLinks

<PageTitle>Requests for new post links · Manage · C# Advent</PageTitle>

<ManageNav />

<nav class="mb-4 text-sm font-medium"><a href="manage/authors" class="text-advent-700 hover:underline">← Authors</a></nav>

<h1 class="text-3xl font-bold tracking-tight text-slate-900">Requests for new post links</h1>
<p class="mt-2 max-w-3xl text-slate-600">
    Authors asking for new links to their posts, oldest first: older posts, usually because they moved their blog, and this
    season's posts once they're revealed, from My spots. Check each new link opens the same post before approving. They're told
    by email either way.
</p>

@if (Message is { } message)
{
    <p class="mt-4 max-w-3xl rounded-xl bg-green-50 p-4 font-medium text-green-800 ring-1 ring-green-200" role="status">@message</p>
}

@if (_requests.Count == 0)
{
    <p class="mt-8 text-slate-600">Nothing's waiting.</p>
}
else
{
    <ul class="mt-8 flex max-w-3xl flex-col gap-3">
        @foreach (var request in _requests)
        {
            <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl p-4 ring-1 ring-slate-200">
                <div>
                    <p class="font-semibold text-slate-900">@request.RequesterLogin</p>
                    <p class="mt-1 text-sm text-slate-600">
                        @(request.Changes.Count == 1 ? "1 post" : $"{request.Changes.Count} posts") ·
                        @string.Join(", ", request.Changes.Select(c => c.Year).Distinct())
                        <span class="text-slate-500">(<LocalTime Value="request.SubmittedAt" />)</span>
                    </p>
                </div>
                <a href="@PostLinkLinks.Review(request.Id)" class="rounded-lg px-3 py-1.5 text-sm font-semibold text-advent-700 ring-1 ring-advent-300 hover:bg-advent-50">Review</a>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<PostLinkReview> _requests = [];

    [SupplyParameterFromQuery(Name = "done")]
    public string? Done { get; set; }

    private string? Message => Done switch
    {
        "approved" => "Approved: the links are changed, and they've been told.",
        "declined" => "Declined, and they've been told.",
        _ => null,
    };

    protected override async Task OnInitializedAsync() => _requests = await PostLinks.ListPendingAsync();
}
