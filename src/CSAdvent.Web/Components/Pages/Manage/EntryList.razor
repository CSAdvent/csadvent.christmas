@page "/manage/entries"
@using CSAdvent.Web.Blurbs
@inject SeasonAdminService Seasons
@inject BlurbQueries Blurbs
@inject EntryAdminService Entries
@inject CSAdvent.Web.Entries.EntryService EntryStats
@inject CSAdvent.Web.DeadLinks.LinkCheckService LinkChecks
@inject AdventSchedule Schedule

<PageTitle>Entries · Manage · C# Advent</PageTitle>

<ManageNav />

<h1 class="text-3xl font-bold tracking-tight text-slate-900">Entries @(_year is { } year ? $"for {year}" : "")</h1>

@if (_entries.Count > 0)
{
    <PastSeasonNotice Year="_year!.Value" />

    <p class="mt-2 text-slate-600">
        @Count(EntryStatus.Ready) ready ·
        @(_entries.Count(e => e.Status is EntryStatus.ClaimedWithoutPost or EntryStatus.TitleOnly or EntryStatus.UrlOnly)) claimed without a complete post ·
        @Count(EntryStatus.Open) open
    </p>

    <nav aria-label="Which entries" class="mt-6 flex flex-wrap gap-2 text-sm font-medium">
        <a href="@ShowLink(attention: false)" aria-current="@(_attentionOnly ? null : "page")"
           class="rounded-lg px-3 py-1.5 @(_attentionOnly ? "text-slate-600 ring-1 ring-slate-200 hover:bg-slate-100" : "bg-slate-900 text-white")">All</a>
        <a href="@ShowLink(attention: true)" aria-current="@(_attentionOnly ? "page" : null)"
           class="rounded-lg px-3 py-1.5 @(_attentionOnly ? "bg-slate-900 text-white" : "text-slate-600 ring-1 ring-slate-200 hover:bg-slate-100")">
            Needs attention <span class="ml-1 tabular-nums">(@_attention.Count)</span>
        </a>
    </nav>
    @if (_attentionOnly)
    {
        <p class="mt-3 max-w-3xl text-sm text-slate-600">
            Spots whose day isn't over yet with no post link (or no title) yet, an author who dropped out and hasn't been replaced,
            or a blurb check that's missing or needs your decision.
        </p>
    }

    @if (Shown.Count == 0)
    {
        <p class="mt-6 text-slate-500">Nothing needs attention right now.</p>
    }
    else
    {
        @* Seven columns don't fit a phone, so the table scrolls sideways there (#170). *@
        <div class="relative mt-4 overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-slate-200 text-slate-500">
                    <tr>
                        <th class="py-2 pr-4 font-medium">Spot</th>
                        <th class="py-2 pr-4 font-medium">Author</th>
                        <th class="py-2 pr-4 font-medium">Post</th>
                        <th class="py-2 pr-4 font-medium">Status</th>
                        @if (_checksBlurbs)
                        {
                            <th class="py-2 pr-4 font-medium">Blurb</th>
                        }
                        <th class="py-2 pr-4 text-right font-medium">Clicks</th>
                        <th class="py-2 font-medium"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var entry in Shown)
                    {
                        <tr class="align-top @(entry.Day == _today ? "bg-advent-50" : "")">
                            <td class="py-2 pr-4 whitespace-nowrap">
                                <a href="manage/entries/@entry.SlotId" class="text-slate-900 hover:underline">December @entry.Day · Post @entry.Part</a>
                                @if (entry.Day == _today)
                                {
                                    <span class="ml-1 rounded-full bg-advent-600 px-2 py-0.5 text-xs font-semibold text-white">Today</span>
                                }
                            </td>
                            <td class="min-w-36 py-2 pr-4">
                                @if (entry.AuthorName is null)
                                {
                                    <span class="text-slate-500">Open</span>
                                    @if (entry.DroppedOut)
                                    {
                                        <span class="ml-1 text-xs text-amber-700">(dropped out)</span>
                                    }
                                }
                                else
                                {
                                    <span class="font-medium text-slate-900">@entry.AuthorName</span>
                                    @if (entry.ContactEmail is { } email)
                                    {
                                        <a href="mailto:@email" class="block break-all text-xs text-slate-600 underline hover:text-advent-700">@email</a>
                                    }
                                    else
                                    {
                                        <span class="ml-1 text-xs text-amber-700">(no email)</span>
                                    }
                                }
                            </td>
                            <td class="min-w-48 py-2 pr-4">
                                @if (entry.PostUrl is { } postUrl)
                                {
                                    @* Straight to the post, not through /go, so organizers' visits aren't counted. *@
                                    <a href="@postUrl" target="_blank" rel="noopener" class="text-advent-700 underline @(entry.PostTitle is null ? "break-all" : "")">@(entry.PostTitle ?? postUrl)</a>
                                }
                                else
                                {
                                    @entry.PostTitle
                                }
                            </td>
                            <td class="py-2 pr-4 whitespace-nowrap">
                                <span class="rounded-full px-2 py-0.5 text-xs font-semibold @BadgeClass(entry.Status)">@Label(entry.Status)</span>
                                @if (_deadLinks.Contains(entry.SlotId))
                                {
                                    @* The dead-link check found it gone from its site (#201). *@
                                    <a href="manage/entries/@entry.SlotId#link-check" class="ml-1 rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-800 hover:underline">Dead link</a>
                                }
                            </td>
                            @if (_checksBlurbs)
                            {
                                <td class="py-2 pr-4 whitespace-nowrap">
                                    @if (_blurbs.GetValueOrDefault(entry.SlotId) is { } blurb)
                                    {
                                        <span title="@blurb.Detail" class="rounded-full px-2 py-0.5 text-xs font-semibold @Labels.Badge(blurb.Status)">@blurb.Label</span>
                                    }
                                </td>
                            }
                            <td class="py-2 pr-4 text-right tabular-nums">@(_clicks.GetValueOrDefault(entry.SlotId))</td>
                            <td class="py-2 text-right"><a href="manage/entries/@entry.SlotId" class="text-advent-700 underline">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (_loaded)
{
    <NoCurrentSeason />
}

@code {
    private int? _year;
    private int? _today;
    private List<EntryListItem> _entries = [];
    private List<EntryListItem> _attention = [];
    private Dictionary<int, int> _clicks = [];
    private Dictionary<int, BlurbState> _blurbs = [];
    private HashSet<int> _deadLinks = [];
    private bool _checksBlurbs;
    private bool _attentionOnly;
    private bool _loaded;

    [SupplyParameterFromQuery]
    public int? Year { get; set; }

    /// <summary><c>attention</c> lists only the spots that need an organizer (#173).</summary>
    [SupplyParameterFromQuery]
    public string? Show { get; set; }

    private List<EntryListItem> Shown => _attentionOnly ? _attention : _entries;

    protected override async Task OnInitializedAsync()
    {
        _attentionOnly = Show == "attention";
        _year = Year ?? await Seasons.GetCurrentYearAsync();
        _entries = _year is { } year ? await Entries.ListAsync(year) : [];
        _clicks = _year is { } clicksYear ? await EntryStats.CountClicksAsync(clicksYear) : [];
        _checksBlurbs = Blurbs.IsEnabled && _year is { } blurbYear && BlurbRules.AppliesTo(blurbYear);
        _blurbs = _checksBlurbs ? await Blurbs.GetSeasonAsync(_year!.Value) : [];
        _deadLinks = _year is { } linksYear ? await LinkChecks.GetDeadAsync(linksYear) : [];
        if (_year is { } shownYear)
        {
            // Today in the season's own calendar, so the test season's rehearsal has one too.
            _today = Schedule.GetDayOfAdvent(shownYear, Schedule.Today);
            _attention = [.. _entries.Where(e =>
                EntryAdminService.NeedsAttention(e, _blurbs.GetValueOrDefault(e.SlotId)?.Status, Schedule.IsDayOver(shownYear, e.Day)))];
        }

        _loaded = true;
    }

    private string ShowLink(bool attention) =>
        "manage/entries" + (attention, Year) switch
        {
            (true, { } year) => $"?year={year}&show=attention",
            (true, null) => "?show=attention",
            (false, { } year) => $"?year={year}",
            _ => "",
        };

    private int Count(EntryStatus status) => _entries.Count(e => e.Status == status);

    private static string Label(EntryStatus status) => status switch
    {
        EntryStatus.Open => "Open",
        EntryStatus.ClaimedWithoutPost => "No post yet",
        EntryStatus.TitleOnly => "Title only",
        EntryStatus.UrlOnly => "URL only",
        _ => "Ready",
    };

    private static string BadgeClass(EntryStatus status) => status switch
    {
        EntryStatus.Open => "bg-slate-100 text-slate-600",
        EntryStatus.Ready => "bg-green-100 text-green-800",
        _ => "bg-amber-100 text-amber-800",
    };
}
