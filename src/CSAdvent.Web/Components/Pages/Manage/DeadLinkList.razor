@page "/manage/authors/dead-links"
@using CSAdvent.Web.DeadLinks
@inject LinkCheckService LinkChecks

<PageTitle>Dead links · Manage · C# Advent</PageTitle>

<ManageNav />

<nav class="mb-4 text-sm font-medium"><a href="manage/authors" class="text-advent-700 hover:underline">← Authors</a></nav>

<h1 class="text-3xl font-bold tracking-tight text-slate-900">Dead links</h1>
<p class="mt-2 max-w-3xl text-slate-600">
    Once a season is over, its posts are checked now and then to see they're still there: a few posts every 15 minutes, each
    about once a month, and never the same site twice in an hour. A post that fails @Options.FailuresBeforeDead checks in a row,
    a day or more apart, is dead, and its saved copy is looked up at the Internet Archive's Wayback Machine, closest to its
    reveal. Readers who follow a dead post's link get that copy. Give a post a new link if its author moved it, or a saved copy
    of your own.
</p>

@if (_counts is { } counts)
{
    <p class="mt-4 text-sm text-slate-600">
        @counts.Dead dead (@counts.DeadWithoutCopy without a saved copy) · @counts.Failing failing · @counts.Refused can't be checked ·
        @counts.Working working · @counts.Unchecked not checked yet
    </p>
}

@foreach (var (status, heading, description) in Sections)
{
    var rows = _rows.Where(r => r.Status == status).ToList();
    <section aria-labelledby="section-@status" class="mt-10">
        <h2 id="section-@status" class="text-xl font-semibold text-slate-900">@heading <span class="text-base font-normal text-slate-500">(@rows.Count)</span></h2>
        <p class="mt-1 max-w-3xl text-sm text-slate-600">@description</p>
        @if (rows.Count == 0)
        {
            <p class="mt-3 text-sm text-slate-500">None.</p>
        }
        else
        {
            <ul class="mt-4 flex max-w-4xl flex-col gap-3">
                @foreach (var row in rows)
                {
                    <li id="post-@row.SlotId" class="scroll-mt-4 rounded-xl p-4 ring-1 ring-slate-200">
                        <LinkCheckCard Row="row" ShowPost="true" ReturnUrl="@($"{LinkCheckService.DeadLinksPage}#post-{row.SlotId}")" Done="@DoneFor(row.SlotId)" />
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    private IReadOnlyList<LinkCheckRow> _rows = [];
    private LinkCheckCounts? _counts;

    [Inject]
    private Microsoft.Extensions.Options.IOptions<LinkCheckOptions> OptionsAccessor { get; set; } = null!;

    private LinkCheckOptions Options => OptionsAccessor.Value;

    /// <summary>What a button just did, and to which post: <c>checked-42</c>.</summary>
    [SupplyParameterFromQuery(Name = "links")]
    public string? LinksDone { get; set; }

    private static readonly (LinkStatus Status, string Heading, string Description)[] Sections =
    [
        (LinkStatus.Dead, "Dead", "Gone from their sites. Readers get the saved copy where there is one, and otherwise the original address."),
        (LinkStatus.Failing, "Failing", "Didn't load the last time or two. They're checked again in a day or two, and they're dead if they keep failing."),
        (LinkStatus.Refused, "Can't be checked", "Their sites turn checks like ours away (403, 429 and the like), so there's no telling. Readers get the original address."),
    ];

    protected override async Task OnInitializedAsync() =>
        (_rows, _counts) = await LinkChecks.ListAsync();

    private string? DoneFor(int slotId) => LinkCheckDone.For(LinksDone, slotId);
}
