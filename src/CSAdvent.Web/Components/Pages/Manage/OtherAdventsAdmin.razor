@page "/manage/other-advents"
@inject SeasonAdminService Seasons
@inject OtherAdventsService Others
@inject NavigationManager Navigation

<PageTitle>Other Advents · Manage · C# Advent</PageTitle>

<ManageNav />

@if (_year is { } year)
{
    <nav class="mb-4 text-sm font-medium"><a href="manage/content" class="text-advent-700 hover:underline">← All content</a></nav>

    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Other Advents for @year</h1>
    <p class="mt-2 max-w-2xl text-slate-600">The list on the <a href="others" class="text-advent-700 underline">Other Advents</a> page. Each season has its own, so last year's stays with last year.</p>

    @if (_items.Count == 0)
    {
        <div class="mt-6 max-w-2xl rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
            <p class="text-slate-700">This season has no list yet, so the page shows the latest season's, or the suggested list.</p>
            <EditForm Model="Copy" FormName="copy" OnSubmit="CopyAsync" class="mt-3">
                <button type="submit" class="rounded-lg bg-advent-600 px-4 py-2 font-semibold text-white hover:bg-advent-700">Start from last year's list</button>
            </EditForm>
        </div>
    }
    else
    {
        <ul class="mt-6 flex max-w-3xl flex-col divide-y divide-slate-100 rounded-xl ring-1 ring-slate-200">
            @foreach (var advent in _items)
            {
                <li class="flex items-start justify-between gap-4 p-4">
                    <div>
                        <a href="@advent.Url" class="font-semibold text-advent-700 underline">@advent.Name</a>
                        @if (advent.Description is { } description)
                        {
                            <p class="text-sm text-slate-600">@description</p>
                        }
                    </div>
                    <form method="post" action="manage/other-advents/remove">
                        <AntiforgeryToken />
                        <input type="hidden" name="Year" value="@year" />
                        <input type="hidden" name="Id" value="@advent.Id" />
                        <button type="submit" class="rounded-md px-2 py-1 text-sm text-red-700 ring-1 ring-red-200 hover:bg-red-50">Remove</button>
                    </form>
                </li>
            }
        </ul>
    }

    <h2 class="mt-10 text-xl font-semibold text-slate-900">Add a calendar</h2>
    <EditForm Model="Form" FormName="add" OnValidSubmit="AddAsync" class="mt-4 flex max-w-2xl flex-col gap-4">
        <DataAnnotationsValidator />
        <ValidationSummary class="rounded-xl bg-red-50 p-4 text-sm ring-1 ring-red-200" />
        <label class="flex flex-col text-sm font-medium text-slate-700">
            Name
            <InputText @bind-Value="Form!.Name" maxlength="100" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
        </label>
        <label class="flex flex-col text-sm font-medium text-slate-700">
            Address
            <InputText @bind-Value="Form!.Url" type="url" maxlength="500" placeholder="https://" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
        </label>
        <label class="flex flex-col text-sm font-medium text-slate-700">
            Description <span class="font-normal text-slate-500">(optional)</span>
            <InputText @bind-Value="Form!.Description" maxlength="500" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 font-normal" />
        </label>
        <div>
            <button type="submit" class="rounded-lg bg-advent-600 px-5 py-2.5 font-semibold text-white hover:bg-advent-700">Add</button>
        </div>
    </EditForm>
}
else if (_loaded)
{
    <p class="text-slate-600">There's no season yet. <a href="manage/seasons" class="text-advent-700 underline">Create one</a> first.</p>
}

@code {
    private int? _year;
    private List<OtherAdventItem> _items = [];
    private bool _loaded;

    [SupplyParameterFromQuery]
    public int? Year { get; set; }

    [SupplyParameterFromForm(FormName = "add")]
    private OtherAdventForm? Form { get; set; }

    [SupplyParameterFromForm(FormName = "copy")]
    private CopyForm? Copy { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Form ??= new OtherAdventForm();
        Copy ??= new CopyForm();
        _loaded = true;
        _year = Year ?? await Seasons.GetCurrentYearAsync();
        _items = _year is { } year ? await Others.ListAsync(year) : [];
    }

    private async Task AddAsync()
    {
        await Others.AddAsync(_year!.Value, Form!);
        Navigation.NavigateTo($"manage/other-advents?year={_year}");
    }

    private async Task CopyAsync()
    {
        await Others.CopyIntoAsync(_year!.Value);
        Navigation.NavigateTo($"manage/other-advents?year={_year}");
    }

    /// <summary>The copy form has no fields; it only needs a model.</summary>
    private sealed class CopyForm;
}
