@* One of the blurb check's buttons: a plain form, because a page can have one per post. *@
@using CSAdvent.Web.Blurbs

<form method="post" action="@Action">
    <AntiforgeryToken />
    <input type="hidden" name="SlotId" value="@SlotId" />
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    @if (Decision is { } decision)
    {
        <input type="hidden" name="Decision" value="@decision" />
    }
    <button type="submit"
            class="rounded-lg px-3 py-1.5 font-medium ring-1 @(Danger ? "text-red-800 ring-red-300 hover:bg-red-50" : "text-slate-800 ring-slate-300 hover:bg-slate-50")">@Label</button>
</form>

@code {
    [Parameter, EditorRequired]
    public string Action { get; set; } = "";

    [Parameter, EditorRequired]
    public int SlotId { get; set; }

    [Parameter, EditorRequired]
    public string ReturnUrl { get; set; } = "";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public BlurbDecision? Decision { get; set; }

    [Parameter]
    public bool Danger { get; set; }
}
