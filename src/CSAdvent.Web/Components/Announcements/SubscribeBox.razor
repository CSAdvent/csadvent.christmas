@* The announcements sign-up form (#49): a plain form to /announcements/subscribe, which is rate limited. *@
@using CSAdvent.Web.Announcements

<div id="announcements" class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
    <h2 class="text-lg font-semibold text-slate-900">@Heading</h2>
    <p class="mt-1 text-slate-600">
        We'll email you when each season's sign-ups open, and now and then with news from the organizers. Nothing else unless
        you ask for the daily posts too, and every email has a one-click unsubscribe.
    </p>

    @if (Done == "check-inbox")
    {
        <p class="mt-3 rounded-lg bg-green-50 p-3 text-sm font-medium text-green-800 ring-1 ring-green-200" role="status">
            Check your inbox for a link to confirm your address. If you already get everything you asked for, there's nothing more to do.
        </p>
    }
    else if (Error is { } error)
    {
        <p class="mt-3 rounded-lg bg-red-50 p-3 text-sm font-medium text-red-800 ring-1 ring-red-200" role="alert">
            @(error == "busy" ? "That's a lot of sign-ups from here. Try again in a few minutes." : "Enter a valid email address.")
        </p>
    }

    <form method="post" action="announcements/subscribe" class="mt-4 flex flex-wrap items-end gap-3">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnTo" />
        @* 16rem wide where there's room, so the button wraps below it, and narrower on the smallest phones. *@
        <label class="flex min-w-0 grow basis-64 flex-col text-sm font-medium text-slate-700">
            Email
            <input type="email" name="Email" required maxlength="254" autocomplete="email" class="mt-1 rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal" />
        </label>
        @* A trap for bots: hidden from people and screen readers, so only a bot fills it in. *@
        <label class="absolute -left-[9999px]" aria-hidden="true">
            Website
            <input type="text" name="Website" tabindex="-1" autocomplete="off" />
        </label>
        <button type="submit" class="rounded-lg bg-advent-600 px-5 py-2 font-semibold text-white hover:bg-advent-700">Email me</button>
        <label class="flex w-full items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" name="DailyPosts" value="true" class="size-4 rounded border-slate-300" />
            Also email me each day's new posts, December 1 to 25
        </label>
    </form>
    <p class="mt-2 text-xs text-slate-500">We'll send a link to confirm your address first. See the <a href="privacy" class="underline">privacy page</a>.</p>
</div>

@code {
    [Parameter]
    public string Heading { get; set; } = "Get C# Advent announcements by email";

    /// <summary>Where the form comes back to: <c>home</c> or the announcements page.</summary>
    [Parameter, EditorRequired]
    public required string ReturnTo { get; set; }

    [Parameter]
    public string? Done { get; set; }

    [Parameter]
    public string? Error { get; set; }
}
