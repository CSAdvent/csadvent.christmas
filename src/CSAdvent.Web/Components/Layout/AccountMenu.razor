@using CSAdvent.Web.Auth
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <li>
            <NavLink href="my-spots" class="block rounded-lg px-3 py-2 hover:bg-white/15" ActiveClass="bg-white/20">My spots</NavLink>
        </li>
        <AuthorizeView Policy="@AdventPolicies.Admin" Context="organizer">
            <li>
                <NavLink href="manage" class="block rounded-lg px-3 py-2 hover:bg-white/15" ActiveClass="bg-white/20">Manage</NavLink>
            </li>
        </AuthorizeView>
        <li>
            <NavLink href="profile" title="Your profile" class="block rounded-lg px-3 py-2 hover:bg-white/15" ActiveClass="bg-white/20">
                <span class="sm:hidden">Profile</span>
                <span class="hidden sm:inline">@context.User.Identity?.Name</span>
            </NavLink>
        </li>
        <li class="flex items-center gap-2">
            <form method="post" action="signout">
                <AntiforgeryToken />
                <button type="submit" class="rounded-lg px-3 py-2 hover:bg-white/15">Sign out</button>
            </form>
        </li>
    </Authorized>
    <NotAuthorized>
        <li>
            <a href="signin?returnUrl=@Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))" class="block rounded-lg bg-white/15 px-3 py-2 hover:bg-white/25">Sign in</a>
        </li>
    </NotAuthorized>
</AuthorizeView>
