@using System.Globalization
@using CSAdvent.Web.SeasonTesting
@inject SeasonAccess Access
@inject AdventSchedule Schedule

@* Only testers ever see this: in test mode, a reminder and the way back; otherwise, an invitation (organizers start from /manage/testing instead). *@
@if (Access.TestSeason is { } season)
{
    @if (Access.InTestMode)
    {
        <div class="bg-amber-300 text-amber-950" role="note">
            <p class="mx-auto max-w-6xl px-4 py-2 text-sm">
                <strong>Test mode.</strong>
                You're seeing the C# Advent test season. In its rehearsal December 1 is on @season.RehearsalStartsOn.ToString("MMMM d", CultureInfo.InvariantCulture)@(Today(season) is { } day ? $", so today is December {day}" : "").
                Only testers can see it, and everything in it is deleted when it's reset.
                <a href="test-mode/off?returnUrl=%2F" class="font-semibold underline">Back to the real site</a>
            </p>
        </div>
    }
    else if (!Access.IsOrganizer)
    {
        <div class="bg-amber-100 text-amber-950" role="note">
            <p class="mx-auto max-w-6xl px-4 py-2 text-sm">
                You're invited to test C# Advent.
                <a href="test-mode/on?returnUrl=%2F" class="font-semibold underline">Switch to test mode</a>
            </p>
        </div>
    }
}

@code {
    private int? Today(TestSeason season) => Schedule.GetDayOfAdvent(season.Year, Schedule.Today);
}
