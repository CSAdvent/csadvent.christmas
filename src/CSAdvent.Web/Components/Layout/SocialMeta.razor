@*
    The tags link previews read: Open Graph (Facebook, LinkedIn, Mastodon, Bluesky, Reddit, Slack, Teams), the large-image
    card that X, Discord and others take from the Twitter tags, and our accounts on X and Mastodon (twitter:site and
    fediverse:creator). URLs are absolute, and the canonical URL drops the query string, so ?via= tags don't split a page
    into many. A page gets one HeadContent (the last one rendered wins), so other head tags go in this component's child
    content.
*@
@using Microsoft.Extensions.Options
@using CSAdvent.Web.Social
@inject IOptions<SiteOptions> Site
@inject IOptions<SocialAccountsOptions> Accounts
@inject NavigationManager Navigation

<HeadContent>
    <meta name="description" content="@Description" />
    <link rel="canonical" href="@Url" />
    <meta property="og:site_name" content="C# Advent" />
    <meta property="og:type" content="@Type" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@Url" />
    <meta property="og:image" content="@ImageUrl" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="@ImageAlt" />
    <meta name="twitter:card" content="summary_large_image" />
    @if (Accounts.Value.X is { Length: > 0 } site)
    {
        <meta name="twitter:site" content="@($"@{site}")" />
    }
    @if (Accounts.Value.Mastodon is { Length: > 0 } creator)
    {
        <meta name="fediverse:creator" content="@creator" />
    }
    @ChildContent
</HeadContent>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public string Description { get; set; } = "";

    /// <summary><c>website</c> for most pages, <c>article</c> for an entry.</summary>
    [Parameter]
    public string Type { get; set; } = "website";

    /// <summary>The card image, relative to the site. Defaults to the branded C# Advent card.</summary>
    [Parameter]
    public string Image { get; set; } = "images/social-card.jpg";

    [Parameter]
    public string ImageAlt { get; set; } = "C# Advent: two C# posts a day, December 1 to 25";

    /// <summary>More head tags for the page, such as a season's feed link.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string Root => Site.Value.BaseUrl.TrimEnd('/');

    private string Url => $"{Root}/{Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0]}".TrimEnd('/');

    private string ImageUrl => $"{Root}/{Image.TrimStart('/')}";
}
