@* One card per day, with that day's entries in part order. Used by the home page and the archive. *@
@using System.Globalization
@using CSAdvent.Web.Entries

<ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var day in Calendar.Days)
    {
        <li id="december-@day.Day" class="flex flex-col rounded-xl bg-white p-4 shadow-sm @(day.IsToday ? "ring-2 ring-advent-500" : "ring-1 ring-slate-200")">
            <h2 class="flex items-baseline gap-2">
                <span class="text-2xl font-bold tabular-nums text-slate-900">@day.Day</span>
                <span class="text-sm font-medium uppercase tracking-wide text-slate-500">December</span>
                @if (day.IsToday)
                {
                    <span class="ml-auto rounded-full bg-advent-600 px-2.5 py-0.5 text-xs font-semibold text-white">Today</span>
                }
            </h2>
            @if (day == Calendar.CountingDownTo)
            {
                @* countdown.js ticks this down, correcting the visitor's clock with data-now, and reloads at the reveal. *@
                <p class="mt-1 text-sm text-slate-600">
                    Revealed in
                    <time datetime="@Iso(day.RevealsAt)" data-countdown="@Iso(day.RevealsAt)" data-now="@Iso(Calendar.GeneratedAt)" class="font-semibold tabular-nums text-advent-700">@Remaining(day.RevealsAt - Calendar.GeneratedAt)</time>
                </p>
            }

            <ul class="mt-3 flex flex-1 flex-col gap-2">
                @foreach (var entry in day.Entries)
                {
                    @* Each spot is its own box, labeled when the day has more than one, so it's clear which one you're claiming. *@
                    <li class="rounded-lg bg-slate-50 px-3 py-2.5 ring-1 ring-slate-100">
                        @if (Calendar.SlotsPerDay > 1)
                        {
                            <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">Post @entry.Part</p>
                        }
                        @if (entry.HasPost)
                        {
                            <a href="@EntryLinks.Go(Calendar.Year, day.Day, entry.Part, "calendar")" class="font-medium text-advent-700 underline decoration-advent-200 decoration-1 underline-offset-2 hover:text-advent-800 hover:decoration-advent-700">@TitleStart(entry.PostTitle)<span class="whitespace-nowrap">@TitleEnd(entry.PostTitle)<svg class="ml-1 inline size-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 13 13 7M8 7h5v5" /></svg></span></a>
                            <p class="mt-1 text-sm text-slate-500">
                                by <Author Entry="entry" />
                            </p>
                        }
                        else if (entry.IsRevealed)
                        {
                            @* Claiming a slot without publishing doesn't earn a credit, so the author isn't named. *@
                            <p class="text-sm italic text-slate-400">No post</p>
                        }
                        else if (!entry.IsOpen)
                        {
                            <p class="text-sm text-slate-600">
                                <span aria-hidden="true">🎁</span> Claimed by <Author Entry="entry" />
                            </p>
                        }
                        else if (Calendar.AreClaimsOpen)
                        {
                            <a href="@CalendarLinks.Claim(Calendar.Year, day.Day, entry.Part)"
                               aria-label="@($"Claim December {day.Day}{(Calendar.SlotsPerDay > 1 ? $", post {entry.Part}" : "")}")"
                               class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-2.5 py-1 text-sm font-medium text-slate-700 hover:border-advent-500 hover:text-advent-700">
                                <span aria-hidden="true">+</span> Claim this spot
                            </a>
                        }
                        else
                        {
                            <p class="text-sm text-slate-400">Open</p>
                        }
                    </li>
                }
            </ul>
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired]
    public required SeasonCalendar Calendar { get; set; }

    private static string Iso(DateTimeOffset moment) => moment.ToString("O", CultureInfo.InvariantCulture);

    /// <summary>"11:42:07": hours, minutes and seconds, as countdown.js writes it.</summary>
    private static string Remaining(TimeSpan left) =>
        string.Create(CultureInfo.InvariantCulture, $"{(int)left.TotalHours}:{left.Minutes:00}:{left.Seconds:00}");

    // The title's last word is rendered with the external-link arrow in a no-wrap span, so the arrow never sits on a line alone.
    private static string TitleStart(string? title) => title?[..(title.LastIndexOf(' ') + 1)] ?? "";

    private static string TitleEnd(string? title) => title?[(title.LastIndexOf(' ') + 1)..] ?? "";
}
