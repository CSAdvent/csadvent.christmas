<header class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-advent-800 sm:text-4xl">Thanks for C# Advent @Calendar.Year!</h1>
    <p class="mt-2 max-w-2xl text-lg text-slate-600">
        All @Calendar.PostCount posts from this year's calendar are below.
        We'll announce sign-ups for C# Advent @(Calendar.Year + 1) here, so check back soon.
    </p>
    <a href="archive" class="mt-5 inline-block rounded-lg bg-advent-600 px-5 py-3 font-semibold text-white shadow hover:bg-advent-700">Browse every season since 2017</a>
</header>

<CalendarGrid Calendar="Calendar" />

@code {
    [Parameter, EditorRequired]
    public required SeasonCalendar Calendar { get; set; }
}
