@using System.Globalization

<header class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">@(Calendar.Year == CSAdvent.Web.Data.Season.TestYear ? "C# Advent test season" : $"C# Advent {Calendar.Year}")</h1>
    <p class="mt-2 max-w-2xl text-lg text-slate-600">Two new C# posts every day from December 1st to December 25th, written by the C# community.</p>

    <p class="mt-5 rounded-xl bg-slate-50 p-4 font-medium text-slate-800 ring-1 ring-slate-200" role="status">
        @if (Calendar.IsFinished)
        {
            @($"That's a wrap! All {Calendar.PostCount} posts are below. Thank you to every author and reader.")
        }
        else if (!Calendar.AreClaimsOpen)
        {
            @(Calendar.ClaimsOpenOn is { } opensOn
                ? $"Sign-ups open on {opensOn.ToString("MMMM d", CultureInfo.InvariantCulture)}."
                : "Sign-ups open soon.")
        }
        else if (Calendar.OpenSpotCount > 0)
        {
            @($"Sign-ups are open: {Calendar.OpenSpotCount} of {Calendar.SpotCount} spots are still available. Pick a day below and claim it.")
        }
        else
        {
            @("Every spot is taken. Thank you!")
        }
    </p>
    @if (Calendar.AreClaimsOpen && !Calendar.IsFinished)
    {
        <p class="mt-3 text-slate-600">
            Can't commit to a day? <a href="backups/@Calendar.Year" class="font-medium text-advent-700 underline">Join the backup list</a>
            and fill in if an author drops out.
        </p>
    }
</header>

<CalendarGrid Calendar="Calendar" />

@code {
    [Parameter, EditorRequired]
    public required SeasonCalendar Calendar { get; set; }
}
