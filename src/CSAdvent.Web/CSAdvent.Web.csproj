<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSAdvent.ServiceDefaults\CSAdvent.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSAdvent.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 2017-2025 history, seeded after migrations by ArchiveSeeder. Embedded, so the migration bundle carries it. -->
    <Content Remove="Data\Archive\*.json" />
    <EmbeddedResource Include="Data\Archive\*.json" LogicalName="archive/%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="..\..\build\Tailwind.targets" />

</Project>
