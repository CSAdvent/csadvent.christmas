@*
    The C# Advent email layout. Email clients are far behind browsers: layout is tables, every style is inline, and
    nothing relies on web fonts or CSS that Outlook and Gmail drop. Colors are the site's advent-* scale. The header photo is
    images/email-header.jpg (the site's snowflakes with its dark overlay baked in); clients that skip background images show
    the same dark blue instead.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>@Content.Subject</title>
</head>
<body style="margin:0;padding:0;background-color:#eef4fb;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#eef4fb;">@Content.Preview</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef4fb;">
        <tr>
            <td align="center" style="padding:24px 12px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;">
                    <tr>
                        <td background="@HeaderUrl" bgcolor="#0e2a52" style="background-color:#0e2a52;background-image:url('@HeaderUrl');background-size:cover;background-position:center;border-radius:16px 16px 0 0;padding:28px 32px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="padding-right:16px;vertical-align:middle;">
                                        <img src="@LogoUrl" width="56" height="56" alt="C# Advent logo" style="display:block;border:0;border-radius:12px;" />
                                    </td>
                                    <td style="vertical-align:middle;font-family:@Font;">
                                        <div style="font-size:24px;font-weight:700;line-height:1.2;color:#ffffff;">C# Advent</div>
                                        <div style="font-size:14px;line-height:1.4;color:#b9d1ec;">Two C# posts a day, December 1–25</div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="background-color:#4e88c5;height:4px;line-height:4px;font-size:4px;">&nbsp;</td>
                    </tr>
                    <tr>
                        <td style="background-color:#ffffff;border-radius:0 0 16px 16px;padding:32px;font-family:@Font;font-size:16px;line-height:1.6;color:#334155;">
                            <h1 style="margin:0 0 20px;font-size:24px;line-height:1.3;font-weight:700;color:#0f172a;">@Content.Heading</h1>
                            @foreach (var block in Content.Body)
                            {
                                switch (block)
                                {
                                    case ParagraphBlock paragraph:
                                        <p style="margin:0 0 16px;"><EmailSpans Spans="paragraph.Spans" /></p>
                                        break;
                                    case ListBlock list:
                                        <ul style="margin:0 0 16px;padding-left:24px;">
                                            @foreach (var item in list.Items)
                                            {
                                                <li style="margin:0 0 8px;"><EmailSpans Spans="item" /></li>
                                            }
                                        </ul>
                                        break;
                                    case ButtonBlock button:
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px;">
                                            <tr>
                                                <td style="background-color:#1a509d;border-radius:8px;">
                                                    <a href="@button.Url" style="display:inline-block;padding:12px 24px;font-family:@Font;font-size:16px;font-weight:600;line-height:1.2;color:#ffffff;text-decoration:none;border-radius:8px;">@button.Label</a>
                                                </td>
                                            </tr>
                                        </table>
                                        break;
                                    case DetailsBlock details:
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;border-collapse:collapse;">
                                            @foreach (var row in details.Rows)
                                            {
                                                <tr>
                                                    <td style="padding:8px 16px 8px 0;border-top:1px solid #e2e8f0;vertical-align:top;white-space:nowrap;font-size:14px;color:#64748b;">@row.Label</td>
                                                    <td style="padding:8px 0;border-top:1px solid #e2e8f0;vertical-align:top;font-size:15px;color:#0f172a;word-break:break-word;">@row.Value</td>
                                                </tr>
                                            }
                                        </table>
                                        break;
                                }
                            }
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding:24px 32px;font-family:@Font;font-size:13px;line-height:1.6;color:#64748b;">
                            <p style="margin:0 0 8px;">C# Advent: a community calendar of C# content, every December since 2017.</p>
                            <p style="margin:0 0 8px;">
                                <a href="@Site" style="color:#164383;text-decoration:underline;">@Host</a>
                                &nbsp;·&nbsp;
                                <a href="@PrivacyUrl" style="color:#164383;text-decoration:underline;">Privacy</a>
                                &nbsp;·&nbsp;
                                <a href="@TermsUrl" style="color:#164383;text-decoration:underline;">Terms</a>
                            </p>
                            @if (Content.Reason is { } reason)
                            {
                                <p style="margin:0;">@reason</p>
                            }
                            @if (Content.UnsubscribeUrl is { } unsubscribe)
                            {
                                <p style="margin:8px 0 0;">Don't want these emails? <a href="@unsubscribe" style="color:#164383;text-decoration:underline;">Unsubscribe</a>.</p>
                            }
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>

@code {
    private const string Font = "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif";

    [Parameter, EditorRequired]
    public EmailContent Content { get; set; } = null!;

    /// <summary>The site's address, for the logo and links, such as <c>https://csadvent.christmas</c>.</summary>
    [Parameter, EditorRequired]
    public string BaseUrl { get; set; } = "";

    private string Site => BaseUrl.TrimEnd('/');

    private string Host => new Uri(BaseUrl).Host;

    // The original (not fingerprinted) path, so emails sitting in inboxes keep working after the image changes.
    private string LogoUrl => $"{Site}/images/csadvent-logo.png";

    private string HeaderUrl => $"{Site}/images/email-header.jpg";

    private string PrivacyUrl => $"{Site}/privacy";

    private string TermsUrl => $"{Site}/terms";
}
