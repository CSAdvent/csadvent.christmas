<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Aspire hosting">
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.Azure.PostgreSQL" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.EntityFrameworkCore" Version="13.6.2-preview.1.26519.11" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.2" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.0" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.2" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.2" />
    <!-- Pinned (transitively, through Aspire.Npgsql.EntityFrameworkCore.PostgreSQL) so the EF Core health check matches EF Core 11 -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>
  <ItemGroup Label="Web">
    <PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="Markdig" Version="1.4.2" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <!-- Skia's native library for Linux containers, without a fontconfig dependency (the card fonts are embedded) -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup Label="Service defaults">
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.2" />
    <PackageVersion Include="bunit" Version="2.12.5" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
</Project>
